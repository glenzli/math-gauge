  "stages": [
    {
      "id": "S1",
      "title": "切片的差与平移分离",
      "kind": "prove",
      "depends_on": [],
      "assumptions": [
        "B_H 非空",
        "F⊆A，且 F 中不同点属于不同 H 陪集"
      ],
      "expected": "true",
      "required_evidence": [
        "证明 B_H−B_H⊆H",
        "证明 t+B_H 对 t∈F 两两不交",
        "证明 |F||B_H|≤|A+B_H|"
      ],
      "critical_errors": [
        "把加法阿贝尔群改成特征 2",
        "忘记 F 的不同点必须属于不同陪集"
      ],
      "points": 15,
      "lean_required": false
    },
    {
      "id": "S2",
      "title": "完整生成原覆盖定理",
      "kind": "construct",
      "depends_on": [
        "S1"
      ],
      "assumptions": [
        "仅题面原始条件，无有限商群或额外 K 正性假设"
      ],
      "expected": "construction",
      "required_evidence": [
        "构造 F⊆A 覆盖 A",
        "证明 |F|≤K|A|/|B_H|",
        "提供有限选代表或 Ruzsa 路线的完整论证"
      ],
      "critical_errors": [
        "只证明差集包含而未构造 F",
        "加入群有限或所有陪集等大小于切片等假设"
      ],
      "points": 20,
      "lean_required": false
    },
    {
      "id": "S3",
      "title": "商群中的精确最小值",
      "kind": "prove",
      "depends_on": [
        "S1",
        "S2"
      ],
      "assumptions": [
        "π_H:G→G/H 为商映射",
        "F⊆A 有限"
      ],
      "expected": "true",
      "required_evidence": [
        "证明 F 覆盖 A 当且仅当 π_H(F)=π_H(A)",
        "证明最小覆盖数为 c_H(A)=|π_H(A)|",
        "将 S2 界写成 c_H(A) 的上界"
      ],
      "critical_errors": [
        "把 π_H 在 A 上必单射作为默认",
        "把覆盖等价误写成 π_H(F)⊆π_H(A)"
      ],
      "points": 15,
      "lean_required": false
    },
    {
      "id": "S4",
      "title": "所有切片能否消去密度因子",
      "kind": "decide",
      "depends_on": [
        "S2",
        "S3"
      ],
      "assumptions": [
        "A 分为其所有非空 H 陪集切片",
        "对每个切片均可应用 S2",
        "仍仅有 |A+A|≤K|A|"
      ],
      "expected": "false",
      "required_evidence": [
        "判断能否由全部切片估计推出 c_H(A)≤K",
        "给出完整有限反例",
        "指出把各切片界平均或相加时的实际结论"
      ],
      "critical_errors": [
        "未经论证消去 |A|/|B_H|",
        "反例的 K 不是有效倍增参数"
      ],
      "points": 15,
      "lean_required": false
    },
    {
      "id": "S5",
      "title": "放大子群后重新选择代表",
      "kind": "decide",
      "depends_on": [
        "S1",
        "S2",
        "S3"
      ],
      "assumptions": [
        "H≤L≤G",
        "同一 A、x、K",
        "F_H⊆A 是任一 H 覆盖集",
        "B_L={a∈A:a−x∈L}"
      ],
      "expected": "true",
      "required_evidence": [
        "证明 B_H⊆B_L 且 B_L 非空",
        "构造 F_L⊆F_H 使其为 L 覆盖集",
        "证明可使 |F_L|=c_L(A)≤K|A|/|B_L|"
      ],
      "critical_errors": [
        "误称任意原 F_H 自身已经满足新的更强基数界",
        "遗漏从 F_H 中每个 L 陪集选择代表的理由"
      ],
      "points": 15,
      "lean_required": false
    },
    {
      "id": "S6",
      "title": "完整 Lean 生成",
      "kind": "formalize",
      "depends_on": [
        "S1",
        "S2",
        "S3",
        "S4",
        "S5"
      ],
      "assumptions": [
        "各阶段单独的条件，不能把 H≤L 等共享到原目标"
      ],
      "expected": "construction",
      "required_evidence": [
        "Answer.lean 形式化 S1–S5，包括 S4 有限反例",
        "保留原覆盖定理的无附加假设范围",
        "证明代表的选择、基数和新的子群覆盖，实际编译"
      ],
      "critical_errors": [
        "只提供自然语言选择而 Lean 中加存在代表公理",
        "只实现某个固定有限群",
        "把非空切片作为待证字段而不使用题面给定条件"
      ],
      "points": 20,
      "lean_required": true
    }
  ],
  "turns": [
    {
      "stage_id": "S4",
      "earlier_stage_ids": [
        "S2",
        "S3"
      ],
      "changed_assumptions": "对所有非空切片分别有界，要求合并成去掉密度因子的全局界",
