{
  "id": "MG-GF104",
  "version": "0.1.0",
  "parent_case_id": "MG-F104",
  "title": "初始拓扑、子空间与分离性修复",
  "track": "determinate",
  "task_kind": "repair",
  "stages": [
    {
      "id": "S1",
      "title": "单个可分辨的离散观测",
      "kind": "prove",
      "depends_on": [],
      "assumptions": [
        "A 为单元素集",
        "Y 带离散拓扑",
        "f:X→Y 为单射",
        "X 可为空"
      ],
      "expected": "true",
      "required_evidence": [
        "证明使 f 连续的最粗拓扑是 X 的离散拓扑",
        "说明附件 assembled 在这个范围的值并检查是否满足此特殊目标"
      ],
      "critical_errors": [
        "把单射条件默认为任意观测族均有",
        "把最粗与 Lean 中最小元直接等同"
      ],
      "points": 15,
      "lean_required": false
    },
    {
      "id": "S2",
      "title": "一般观测族的完整构造",
      "kind": "construct",
      "depends_on": [
        "S1"
      ],
      "assumptions": [
        "A 任意，含空指标族",
        "X、Y_a 任意",
        "目标拓扑任意，不假设离散或 T0"
      ],
      "expected": "construction",
      "required_evidence": [
        "构造唯一最粗 τ_f 并证明每个 f_a 连续",
        "证明对任意 Z,s,g，Continuous g ↔ ∀a Continuous(f_a∘g)",
        "解释 A 为空时的拓扑"
      ],
      "critical_errors": [
        "保留 S1 的单射、离散或非空假设",
        "只证明连续性或 iff 的一个方向",
        "把可行拓扑的 sInf 当成自然语言的最粗"
      ],
      "points": 20,
      "lean_required": false
    },
    {
      "id": "S3",
      "title": "限制定义域",
      "kind": "prove",
      "depends_on": [
        "S2"
      ],
      "assumptions": [
        "A、X、Y、f 同 S2",
        "E⊆X 任意，含空集",
        "E 取 τ_f 的子空间拓扑"
      ],
      "expected": "true",
      "required_evidence": [
        "证明子空间拓扑等于限制映射 f_a|E 的初始拓扑",
        "明确包含映射 i:E→X 及所有合成",
        "不假设 E 开、闭或非空"
      ],
      "critical_errors": [
        "仅证明一个拓扑更细",
        "给 E 添加开集或闭集假设"
      ],
      "points": 15,
      "lean_required": false
    },
    {
      "id": "S4",
      "title": "联合可分辨观测",
      "kind": "decide",
      "depends_on": [
        "S2",
        "S3"
      ],
      "assumptions": [
        "每个 Y_a 为 T0 空间",
        "观测族联合单射：若 ∀a,f_a(x)=f_a(x′)，则 x=x′",
        "A 仍允许为空"
      ],
      "expected": "true",
      "required_evidence": [
        "判断 (X,τ_f) 是否必为 T0",
        "证明不同点能被一个开集区分",
        "核查空指标族与空/单点 X"
      ],
      "critical_errors": [
        "把联合单射错误改成每个 f_a 都单射",
        "错误要求 A 有限或所有目标离散"
      ],
      "points": 15,
      "lean_required": false
    },
    {
      "id": "S5",
      "title": "只保留目标的分离性",
      "kind": "decide",
      "depends_on": [
        "S2",
        "S4"
      ],
      "assumptions": [
        "每个 Y_a 为 T0 空间",
        "不再假设观测族联合单射",
        "其余仍同 S2"
      ],
      "expected": "false",
      "required_evidence": [
        "判断 (X,τ_f) 是否必为 T0",
        "给出完全明确的有限反例并计算 τ_f",
        "解释 S4 哪条条件不再满足"
      ],
      "critical_errors": [
        "沿用 S4 的联合单射但不核查",
        "把连续到 T0 空间当成定义域 T0 的充分条件"
      ],
      "points": 10,
      "lean_required": false
    },
    {
      "id": "S6",
      "title": "修复并交付完整 Lean",
      "kind": "formalize",
      "depends_on": [
        "S1",
        "S2",
        "S3",
        "S4",
        "S5"
      ],
      "assumptions": [
        "保持 S2 的完整范围",
        "S3、S4、S5 各自只使用本阶段声明的条件",
        "允许替换错误构造，但不得增加原目标假设"
      ],
      "expected": "construction",
      "required_evidence": [
        "提交修复后的 Core/Construction/Candidate 及新增所需完整源码",
        "完整形式化 S2 的连续、最粗、唯一、映入 iff 四项",
        "形式化 S3 子空间等式、S4 T0 结论及 S5 有限反例",
        "给出 assembled 恒为离散及一般情形失效的形式化见证",
        "逐声明映射数学义务并真实编译、审计公理"
      ],
      "critical_errors": [
        "只改定义但漏掉依赖证明",
        "将通用 iff 改成单向或限制有限指标",
        "把一个编译报错直接称为数学反例",
        "仅编译 S2 而宣称全部扩展覆盖"
      ],
      "points": 25,
      "lean_required": true
    }
  ],
  "turns": [
    {
      "stage_id": "S4",
      "earlier_stage_ids": [
        "S2",
        "S3"
      ],
      "changed_assumptions": "任意目标改为 T0，并加入观测族联合单射，仍不限制指标基数",
      "expected_truth": "true",
      "tempting_invalid_transfer": "把 S1 的单个离散单射条件误当成此处的必要条件",
      "correct_boundary": "T0 只需对每对不同点找到一个能区分它们的观测",
      "mechanism": "joint separation and local-to-global",
      "target_claim": "目标均 T0 且观测族联合单射，则初始拓扑为 T0，其任意子空间也为 T0。",
      "scope": "stage"
    },
    {
      "stage_id": "S5",
      "earlier_stage_ids": [
        "S2",
        "S4"
      ],
      "changed_assumptions": "删除联合单射而保留目标 T0",
      "expected_truth": "false",
      "tempting_invalid_transfer": "从目标 T0 与观测连续性直接继承定义域 T0",
      "correct_boundary": "未被观测区分的点仍可在初始拓扑中不可分辨",
      "mechanism": "loss of observation faithfulness",
      "target_claim": "仅各目标 T0 而无联合单射，也足以使定义域的初始拓扑 T0。",
      "scope": "stage"
    }
  ],
