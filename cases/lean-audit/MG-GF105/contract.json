{
  "id": "MG-GF105",
  "version": "0.1.1",
  "parent_case_id": "MG-F105",
  "title": "陪集切片、最小覆盖与空切片",
  "track": "determinate",
  "task_kind": "audit",
  "stages": [
    {
      "id": "S1",
      "title": "有限平移覆盖",
      "kind": "prove",
      "depends_on": [],
      "assumptions": [
        "A、B 为任意有限群内子集",
        "B≠∅",
        "G 阿贝尔，无有限商群假设"
      ],
      "expected": "true",
      "required_evidence": [
        "构造使 t+B 两两不交的包含极大 F⊆A",
        "证明 A⊆F+(B−B)",
        "证明 |F||B|≤|A+B|"
      ],
      "critical_errors": [
        "要求无关的商群有限或 G 有限",
        "把包含极大错误当成基数最大但不证明存在"
      ],
      "points": 20,
      "lean_required": false
    },
    {
      "id": "S2",
      "title": "原切片覆盖界",
      "kind": "prove",
      "depends_on": [
        "S1"
      ],
      "assumptions": [
        "B={a∈A:a−x∈H} 非空",
        "|A+A|≤K|A|"
      ],
      "expected": "true",
      "required_evidence": [
        "证明 B−B⊆H",
        "证明 |A+B|≤K|A|",
        "得到 F⊆A、覆盖和 |F|≤K|A|/|B|"
      ],
      "critical_errors": [
        "额外假设 x∈H、K>0 或商群有限",
        "忽视 |B|>0 才能除法"
      ],
      "points": 20,
      "lean_required": false
    },
    {
      "id": "S3",
      "title": "精确最小覆盖数",
      "kind": "prove",
      "depends_on": [
        "S1",
        "S2"
      ],
      "assumptions": [
        "A 有限",
        "H 任意",
        "c_H(A) 为 A 相交的 H 陪集数"
      ],
      "expected": "true",
      "required_evidence": [
        "证明任意覆盖集至少 c_H(A) 个点",
        "构造恰有 c_H(A) 个点的 F⊆A",
        "在 S2 条件下推出 c_H(A)≤K|A|/|B|"
      ],
      "critical_errors": [
        "把上界当成精确等式",
        "把一个陪集中的多个代表错误计为多个必需陪集"
      ],
      "points": 15,
      "lean_required": false
    },
    {
      "id": "S4",
      "title": "代表点能否全部取自切片",
      "kind": "decide",
      "depends_on": [
        "S2",
        "S3"
      ],
      "assumptions": [
        "S2 的全部条件",
        "额外要求 F⊆B 而不仅 F⊆A"
      ],
      "expected": "false",
      "required_evidence": [
        "判断此加强是否总可行",
        "验证有限反例的切片、倍增常数和无法覆盖"
      ],
      "critical_errors": [
        "反例未满足原倍增条件",
        "把 B−B⊆H 误当成 B 横跨所有陪集"
      ],
      "points": 15,
      "lean_required": false
    },
    {
      "id": "S5",
      "title": "清除分母后的空切片范围",
      "kind": "decide",
      "depends_on": [
        "S2",
        "S3"
      ],
      "assumptions": [
        "B 可为空，其余定义不变",
        "仍有 |A+A|≤K|A|",
        "要求 |F||B|≤K|A| 而不是商式界"
      ],
      "expected": "true",
      "required_evidence": [
        "判断是否总存在 F⊆A 覆盖且满足乘积界",
        "分别处理 B 非空与 B 为空",
        "说明实数除以零不能恢复原结论"
      ],
      "critical_errors": [
        "对 B=∅ 仍进行正数除法",
        "把 Lean 中 /0=0 当成原商式自然延伸"
      ],
      "points": 10,
      "lean_required": false
    },
    {
      "id": "S6",
      "title": "原实现的完整对齐审计",
      "kind": "audit",
      "depends_on": [
        "S1",
        "S2",
        "S3",
        "S5"
      ],
      "assumptions": [
        "以 S2 为原目标",
        "输入中的 classical/DecidableEq 仅按实际用途审查"
      ],
      "expected": "aligned",
      "required_evidence": [
        "逐步对照 cosetSlice、slice_difference、lift_cover 和主定理",
        "核实除法前的正性及类型转换",
        "说明 S5 不属于原源码已证明范围"
      ],
      "critical_errors": [
        "把可选择等号接口当数学有限性假设",
        "因 S5 有新边界而误判原非空条件错误",
        "仅凭 Lean 编译跳过覆盖的语义"
      ],
      "points": 20,
      "lean_required": false
    }
  ],
  "turns": [
    {
      "stage_id": "S4",
      "earlier_stage_ids": [
        "S2",
        "S3"
      ],
      "changed_assumptions": "代表点允许从整个 A 取，改成只能从单一切片 B 取",
      "expected_truth": "false",
      "tempting_invalid_transfer": "把切片用于差集控制的作用错当成跨陪集选代表的能力",
      "correct_boundary": "切片只位于一个陪集，不能覆盖 A 的其他陪集",
      "mechanism": "selection domain restriction",
      "target_claim": "原切片覆盖定理中的代表集总可以加强为 F⊆B，同时保留覆盖及基数界。",
      "scope": "stage"
    },
    {
      "stage_id": "S5",
      "earlier_stage_ids": [
        "S2",
        "S3"
      ],
      "changed_assumptions": "允许空切片，同时把商式界准确改成乘积界",
      "expected_truth": "true",
      "tempting_invalid_transfer": "沿用正分母除法或因原定理要求非空而否定修改后的结论",
      "correct_boundary": "空切片时取 F=A，乘积界退化为 0≤K|A|",
      "mechanism": "boundary with a changed conclusion",
      "target_claim": "允许 B 为空时，总存在 F⊆A 覆盖且满足 |F||B|≤K|A|。",
      "scope": "stage"
    }
  ],
