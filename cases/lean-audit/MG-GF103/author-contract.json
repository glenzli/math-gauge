{
  "id": "MG-GF103",
  "version": "0.1.0",
  "parent_case_id": "MG-F103",
  "title": "初始拓扑的比较与测试空间",
  "track": "determinate",
  "task_kind": "audit",
  "stages": [
    {
      "id": "S1",
      "title": "完整映入性质",
      "kind": "prove",
      "depends_on": [],
      "assumptions": [
        "A、X、Y_a、t_a、f_a 任意"
      ],
      "expected": "true",
      "required_evidence": [
        "构造 τ_t 并证明最粗性、唯一性",
        "证明对全部 Z,s,g 的映入 iff",
        "计算空指标族"
      ],
      "critical_errors": [
        "遗漏 iff 反向或任意 Z",
        "自行排除空指标族"
      ],
      "points": 20,
      "lean_required": false
    },
    {
      "id": "S2",
      "title": "加细目标拓扑",
      "kind": "prove",
      "depends_on": [
        "S1"
      ],
      "assumptions": [
        "同一 X、A、Y、f",
        "对每个 a，t_a 比 u_a 细，即 u_a 的每个开集在 t_a 也开"
      ],
      "expected": "true",
      "required_evidence": [
        "证明 τ_t 比 τ_u 细",
        "用 S1 核对连续恒等映射方向"
      ],
      "critical_errors": [
        "反转粗细或连续恒等映射方向",
        "把目标拓扑改变误认为源集合改变"
      ],
      "points": 15,
      "lean_required": false
    },
    {
      "id": "S3",
      "title": "能否从初始拓扑恢复目标",
      "kind": "decide",
      "depends_on": [
        "S1",
        "S2"
      ],
      "assumptions": [
        "同一 X、A、Y、f",
        "只知 τ_t=τ_u"
      ],
      "expected": "false",
      "required_evidence": [
        "判断是否必有每个 t_a=u_a",
        "给出源、目标、观测与两个目标拓扑的完整反例"
      ],
      "critical_errors": [
        "暗中假设观测满射或拓扑可由像检测",
        "只说信息不足而不给反例"
      ],
      "points": 15,
      "lean_required": false
    },
    {
      "id": "S4",
      "title": "只以点作测试",
      "kind": "decide",
      "depends_on": [
        "S1",
        "S3"
      ],
      "assumptions": [
        "σ 是 X 上使全部 f_a 连续的拓扑",
        "只对单点测试空间 Z=Unit 及其所有 g:Z→X 检查映入 iff"
      ],
      "expected": "false",
      "required_evidence": [
        "判断这些检查是否足以推出 σ=τ_t",
        "反例需满足 σ 可行及所有单点测试",
        "展示 τ_t 与 σ 不同"
      ],
      "critical_errors": [
        "把 ∀单点映射 偷换成 ∀拓扑空间映射",
        "漏检 σ 的可行性"
      ],
      "points": 15,
      "lean_required": false
    },
    {
      "id": "S5",
      "title": "一个指定测试是否足够",
      "kind": "decide",
      "depends_on": [
        "S1",
        "S2",
        "S4"
      ],
      "assumptions": [
        "σ 可行",
        "唯一额外测试是 id:(X,τ_t)→(X,σ) 连续"
      ],
      "expected": "true",
      "required_evidence": [
        "证明此单个测试加可行性足以推出 σ=τ_t",
        "核对恒等映射方向",
        "解释为何不与 S4 矛盾"
      ],
      "critical_errors": [
        "使用反向 id 的自动连续性",
        "忽略 σ 可行条件"
      ],
      "points": 15,
      "lean_required": false
    },
    {
      "id": "S6",
      "title": "附件的语义与范围审计",
      "kind": "audit",
      "depends_on": [
        "S1",
        "S2",
        "S4",
        "S5"
      ],
      "assumptions": [
        "以 S1 的全范围为原目标",
        "审核源码真实的四项声明及依赖"
      ],
      "expected": "aligned",
      "required_evidence": [
        "核对连续、最粗、唯一、任意映入 iff 四项",
        "解释 iInf 与自然语言最粗相容的序方向",
        "说明空族不破坏实现",
        "区分本次新增 S2–S5 与原输入的覆盖范围"
      ],
      "critical_errors": [
        "仅因看到 iInf 就判错",
        "把 S4 的削弱测试当作代码真实量词",
        "把旧代码编译宣称为新增定理已形式化"
      ],
      "points": 20,
      "lean_required": false
    }
  ],
  "turns": [
    {
      "stage_id": "S3",
      "earlier_stage_ids": [
        "S1",
        "S2"
      ],
      "changed_assumptions": "从给定目标拓扑的正向比较改为由初始拓扑相等反推目标拓扑相等",
      "expected_truth": "false",
      "tempting_invalid_transfer": "把单调性当成反射相等或单射性",
      "correct_boundary": "观测映射可以丢失目标的开集信息",
      "mechanism": "forward versus reflected information",
      "target_claim": "相同观测族的初始拓扑 τ_t=τ_u 蕴含每个目标拓扑 t_a=u_a。",
      "scope": "stage"
    },
    {
      "stage_id": "S4",
      "earlier_stage_ids": [
        "S1",
        "S3"
      ],
      "changed_assumptions": "将任意拓扑测试空间缩小为单点空间",
      "expected_truth": "false",
      "tempting_invalid_transfer": "把全部点映射测试当成完整连续性泛性质",
      "correct_boundary": "单点空间不能检测 X 的开集族",
      "mechanism": "quantifier domain restriction",
      "target_claim": "可行 σ 通过全部单点测试空间的映入 iff 检查，足以推出 σ=τ_t。",
      "scope": "stage"
    },
    {
      "stage_id": "S5",
      "earlier_stage_ids": [
        "S1",
        "S4"
      ],
      "changed_assumptions": "保留可行性，改为具有指定源拓扑及方向的恒等测试",
      "expected_truth": "true",
      "tempting_invalid_transfer": "因 S4 不足而误判任何单一测试都不足",
      "correct_boundary": "可行性给一个包含，指定恒等连续性给另一个包含",
      "mechanism": "test object and map direction",
      "target_claim": "σ 可行且 id:(X,τ_t)→(X,σ) 连续，足以推出 σ=τ_t。",
      "scope": "stage"
    }
  ],
