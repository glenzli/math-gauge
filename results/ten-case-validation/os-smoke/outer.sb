(version 1)
(allow default)
(deny file-read-data (require-all (subpath "/private/tmp/math-gauge-sol-engineering-20261029/macos-policy-smoke/denied-data") (require-not (subpath "/private/tmp/math-gauge-sol-engineering-20261029/macos-policy-smoke/run"))))
(deny file-write* (require-all (subpath "/private/tmp/math-gauge-sol-engineering-20261029/macos-policy-smoke/denied-data") (require-not (subpath "/private/tmp/math-gauge-sol-engineering-20261029/macos-policy-smoke/run"))))
(deny network-outbound (remote ip "localhost:*"))
