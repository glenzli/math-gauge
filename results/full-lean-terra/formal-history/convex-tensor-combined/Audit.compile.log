theorem MathGauge.ConvexCost.finite_observation_reconstruction.{u_1} : ∀ {E : Type u_1} [inst : AddCommGroup E]
  [inst_1 : Module ℝ E] [inst_2 : TopologicalSpace E] [IsTopologicalAddGroup E] [ContinuousSMul ℝ E]
  [LocallyConvexSpace ℝ E] (f : E → ENNReal),
  MathGauge.ConvexCost.JensenConvex f →
    (∃ x, f x ≠ ⊤) →
      LowerSemicontinuous (MathGauge.ConvexCost.reconstruct f) ∧
        MathGauge.ConvexCost.JensenConvex (MathGauge.ConvexCost.reconstruct f) ∧
          MathGauge.ConvexCost.reconstruct f ≤ f ∧
            (∃ x, MathGauge.ConvexCost.reconstruct f x ≠ ⊤) ∧
              (∀ (h : E → ENNReal),
                  LowerSemicontinuous h →
                    MathGauge.ConvexCost.JensenConvex h → h ≤ f → h ≤ MathGauge.ConvexCost.reconstruct f) ∧
                ∀ (F : MathGauge.ConvexCost.FiniteObservation E),
                  MathGauge.ConvexCost.JensenConvex (MathGauge.ConvexCost.record (↑F) f) :=
fun {E} [AddCommGroup E] [Module ℝ E] [TopologicalSpace E] [IsTopologicalAddGroup E] [ContinuousSMul ℝ E]
    [LocallyConvexSpace ℝ E] f hf hp =>
  Eq.mpr
    (id
      (congrArg
        (fun _a =>
          LowerSemicontinuous _a ∧
            MathGauge.ConvexCost.JensenConvex _a ∧
              _a ≤ f ∧
                (∃ x, _a x ≠ ⊤) ∧
                  (∀ (h : E → ENNReal), LowerSemicontinuous h → MathGauge.ConvexCost.JensenConvex h → h ≤ f → h ≤ _a) ∧
                    ∀ (F : MathGauge.ConvexCost.FiniteObservation E),
                      MathGauge.ConvexCost.JensenConvex (MathGauge.ConvexCost.record (↑F) f))
        (MathGauge.ConvexCost.reconstruct_eq_affineHull f)))
    ⟨MathGauge.ConvexCost.affineHull_lowerSemicontinuous f,
      ⟨MathGauge.ConvexCost.jensen_of_convexCost (MathGauge.ConvexCost.affineHull_convex f),
        ⟨MathGauge.ConvexCost.affineHull_le f,
          ⟨Exists.casesOn hp fun x hx =>
              Exists.intro x (ne_top_of_le_ne_top hx (MathGauge.ConvexCost.affineHull_le f x)),
            ⟨fun h hc hv hh =>
              MathGauge.ConvexCost.affineHull_maximal hp hc (MathGauge.ConvexCost.convexCost_of_jensen hv) hh, fun F =>
              MathGauge.ConvexCost.fiberInf_jensen (↑(MathGauge.ConvexCost.observationMap ↑F)) hf⟩⟩⟩⟩⟩
theorem MathGauge.ConvexCost.reconstruct_maximal_ereal.{u_1} : ∀ {E : Type u_1} [inst : AddCommGroup E]
  [inst_1 : Module ℝ E] [inst_2 : TopologicalSpace E] [IsTopologicalAddGroup E] [ContinuousSMul ℝ E]
  [LocallyConvexSpace ℝ E] {f : E → ENNReal},
  MathGauge.ConvexCost.JensenConvex f →
    (∃ x, f x ≠ ⊤) →
      ∀ (h : E → EReal),
        LowerSemicontinuous h → (∀ (x : E), h x ≤ ↑(f x)) → ∀ (x : E), h x ≤ ↑(MathGauge.ConvexCost.reconstruct f x) :=
fun {E} [AddCommGroup E] [Module ℝ E] [TopologicalSpace E] [IsTopologicalAddGroup E] [ContinuousSMul ℝ E]
    [LocallyConvexSpace ℝ E] {f} hf hp h hc hle =>
  have hclosed :=
    IsClosed.preimage (Continuous.prodMk continuous_fst (Continuous.comp continuous_coe_real_ereal continuous_snd))
      (LowerSemicontinuous.isClosed_epigraph hc);
  have hsub :=
    closure_minimal
      (fun ⦃p⦄ hp' =>
        have he :=
          Eq.mpr (id (congrArg (fun _a => _a = ↑p.2) EReal.coe_ennreal_ofReal))
            (Eq.mpr (id (congrArg (fun _a => ↑_a = ↑p.2) (max_eq_left hp'.left))) (Eq.refl ↑p.2));
        LE.le.trans (hle p.1) (he ▸ EReal.coe_ennreal_le_coe_ennreal_iff.mpr hp'.right))
      hclosed;
  fun x =>
  Eq.mpr (id (congrArg (fun _a => h x ≤ ↑(_a x)) (MathGauge.ConvexCost.reconstruct_eq_affineHull f)))
    (if hx : MathGauge.ConvexCost.affineHull f x = ⊤ then
      of_eq_true (Eq.trans (congrArg (LE.le (h x)) (congrArg ENNReal.toEReal hx)) le_top._simp_2)
    else
      have hm := ⟨ENNReal.toReal_nonneg, Eq.ge (ENNReal.ofReal_toReal hx)⟩;
      Eq.mp (congrArg (LE.le (h x)) (EReal.coe_ennreal_toReal hx))
        (hsub
          (Eq.mp
            (congrArg (fun _a => (x, (MathGauge.ConvexCost.affineHull f x).toReal) ∈ _a)
              (MathGauge.ConvexCost.epigraph_affineHull_eq_closure (MathGauge.ConvexCost.convexCost_of_jensen hf) hp))
            hm)))
theorem MathGauge.Tower.FreeTower.classification.{u} : ∀ (T : MathGauge.Tower.FreeTower ℤ),
  (T.Representable ↔ Module.Finite ℤ T.Invariant) ∧
    (MathGauge.TensorClassification.PreservesCountableLimits T.recordFunctor ↔ Module.Finite ℤ T.Invariant) ∧
      (Function.Surjective ⇑T.recordProductMap ↔ Module.Finite ℤ T.Invariant) ∧
        (Module.Finite ℤ T.Invariant ↔ Module.Finite ℤ T.Invariant ∧ Module.Free ℤ T.Invariant) :=
fun T =>
  ⟨MathGauge.Tower.FreeTower.representable_iff_finite T,
    ⟨MathGauge.Tower.FreeTower.countable_limits_iff_finite T,
      ⟨MathGauge.Tower.FreeTower.product_surjective_iff_finite T, MathGauge.Tower.FreeTower.finite_iff_finite_free T⟩⟩⟩
theorem MathGauge.Tower.FreeTower.all_record_representing_objects.{u} : ∀ (T : MathGauge.Tower.FreeTower ℤ)
  [Module.Finite ℤ T.Invariant] (P : ModuleCat ℤ),
  Nonempty (T.recordFunctor ≅ MathGauge.TensorClassification.homFunctor ↑P) ↔
    Nonempty (↑P ≃ₗ[ℤ] Module.Dual ℤ T.Invariant) :=
fun T [Module.Finite ℤ T.Invariant] P =>
  {
    mp := fun a =>
      Nonempty.casesOn a fun e =>
        Nonempty.intro (MathGauge.TensorClassification.representingObjectEquiv (e.symm ≪≫ T.canonicalRepresentation)),
    mpr := fun a =>
      Nonempty.casesOn a fun e =>
        Nonempty.intro (T.canonicalRepresentation ≪≫ MathGauge.TensorClassification.homIsoOfEquiv e.symm) }
def MathGauge.Tower.FreeTower.recordNatEquiv.{u} : {R : Type} →
  [inst : CommRing R] →
    (T S : MathGauge.Tower.FreeTower R) → (T.recordFunctor ⟶ S.recordFunctor) ≃ (T.Invariant →ₗ[R] S.Invariant) :=
fun {R} [CommRing R] T S => (T.recordToTensorNatEquiv S).trans MathGauge.TensorClassification.tensorNatEquiv
def MathGauge.Tower.FreeTower.recordNatEquivInLargerUniverse.{u, v} : {R : Type} →
  [inst : CommRing R] →
    (T S : MathGauge.Tower.FreeTower R) →
      ULift.{(max u v) + 1, u + 1} (T.recordFunctor ⟶ S.recordFunctor) ≃
        ULift.{(max u v) + 1, u} (T.Invariant →ₗ[R] S.Invariant) :=
fun {R} [CommRing R] T S =>
  { toFun := fun η => { down := (T.recordNatEquiv S) η.down },
    invFun := fun f => { down := (T.recordNatEquiv S).symm f.down }, left_inv := ⋯, right_inv := ⋯ }
