import Mathlib.Data.ZMod.Basic
import Mathlib.RingTheory.Localization.AtPrime.Basic
import Mathlib.RingTheory.Localization.Module
import Mathlib.RingTheory.Localization.BaseChange
import Mathlib.RingTheory.Finiteness.Basic
import Mathlib.Algebra.Module.LocalizedModule.Exact
import Mathlib.LinearAlgebra.Basis.VectorSpace
import Mathlib.LinearAlgebra.Quotient.Basic
import Mathlib.Tactic

noncomputable section
namespace MathGauge.LocalSplitting

abbrev R := ℕ → ZMod 2

/-- The actual ideal of sequences which vanish outside a finite set. -/
def finiteSupportIdeal : Ideal R where
  carrier := {a | ∃ N : ℕ, ∀ n, N ≤ n → a n = 0}
  zero_mem' := ⟨0, by simp⟩
  add_mem' := by
    rintro a b ⟨N,hN⟩ ⟨M,hM⟩
    exact ⟨max N M, fun n hn => by simp [hN n (le_trans (le_max_left _ _) hn),
      hM n (le_trans (le_max_right _ _) hn)]⟩
  smul_mem' := by
    rintro a b ⟨N,hN⟩
    exact ⟨N, fun n hn => by simp [hN n hn]⟩

abbrev C := R ⧸ (finiteSupportIdeal : Submodule R R)
def q : R →ₗ[R] C := finiteSupportIdeal.mkQ
def inclusion : finiteSupportIdeal →ₗ[R] R := finiteSupportIdeal.subtype

theorem q_surjective : Function.Surjective q := finiteSupportIdeal.mkQ_surjective

theorem inclusion_injective : Function.Injective inclusion := Subtype.val_injective

theorem row_exact : Function.Exact inclusion q := by
  intro a
  change finiteSupportIdeal.mkQ a = 0 ↔ ∃ b : finiteSupportIdeal, b.val = a
  simp only [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  exact ⟨fun h => ⟨⟨a,h⟩,rfl⟩, fun ⟨b,hb⟩ => hb ▸ b.property⟩

def e (n : ℕ) : R := Pi.single n 1

theorem e_mem (n : ℕ) : e n ∈ finiteSupportIdeal := by
  refine ⟨n+1, fun j hj => ?_⟩
  simp [e, show j ≠ n by omega]

theorem one_not_mem : (1 : R) ∉ finiteSupportIdeal := by
  rintro ⟨N,hN⟩
  have h := hN N le_rfl
  exact one_ne_zero h

theorem q_one_ne_zero : q 1 ≠ 0 := by
  intro h
  exact one_not_mem ((Submodule.Quotient.mk_eq_zero _).1 h)

/-- The quotient is generated by the class of 1. -/
theorem cyclic : ∀ c : C, ∃ a : R, a • q 1 = c := by
  intro c
  obtain ⟨a,rfl⟩ := q_surjective c
  exact ⟨a, by rw [← q.map_smul]; simp⟩

theorem quotient_finitely_generated : Module.Finite R C :=
  Module.Finite.of_surjective q q_surjective

def middle_basis : Module.Basis Unit R R := Module.Basis.singleton Unit R

/-- An actual global linear section is impossible. -/
theorem no_global_section : ¬ ∃ s : C →ₗ[R] R, q.comp s = LinearMap.id := by
  rintro ⟨s,hs⟩
  have hz : s (q 1) = 0 := by
    funext n
    have hq : (e n) • q 1 = 0 := by
      rw [← q.map_smul]
      simpa only [smul_eq_mul, mul_one] using
        ((Submodule.Quotient.mk_eq_zero _).2 (e_mem n) : q (e n) = 0)
    have h := congrArg (fun a : R => a n) (s.map_smul (e n) (q 1))
    rw [hq, map_zero] at h
    simpa [e] using h.symm
  have h := LinearMap.congr_fun hs (q 1)
  simp only [LinearMap.comp_apply, LinearMap.id_apply, hz, map_zero] at h
  exact q_one_ne_zero h.symm

/-- Any decomposition with the specified quotient projection would supply a forbidden section. -/
theorem no_compatible_decomposition :
    ¬ ∃ e : R ≃ₗ[R] finiteSupportIdeal × C,
      (LinearMap.snd R finiteSupportIdeal C).comp e.toLinearMap = q := by
  rintro ⟨e,he⟩
  apply no_global_section
  refine ⟨e.symm.toLinearMap.comp (LinearMap.inr R finiteSupportIdeal C), ?_⟩
  apply LinearMap.ext
  intro c
  have h := LinearMap.congr_fun he (e.symm (0,c))
  simpa using h.symm

theorem boolean_identity (a : R) : a*a = a := by
  funext n
  change a n * a n = a n
  have h : ∀ z : ZMod 2, z*z=z := by decide
  exact h (a n)

section Local
variable (p : Ideal R) [p.IsPrime]
abbrev Rp := Localization.AtPrime p

theorem image_outside_prime (a : R) (ha : a ∉ p) :
    algebraMap R (Rp p) a = 1 := by
  have h : algebraMap R (Rp p) (a-1) = 0 := by
    apply (IsLocalization.map_eq_zero_iff p.primeCompl (Rp p) (a-1)).2
    refine ⟨⟨a,ha⟩, ?_⟩
    change a*(a-1)=0
    rw [mul_sub, boolean_identity, mul_one, sub_self]
  simpa only [map_sub, map_one, sub_eq_zero] using h

theorem image_inside_prime (a : R) (ha : a ∈ p) :
    algebraMap R (Rp p) a = 0 := by
  have hc : 1-a ∉ p := by
    intro h
    have h1 := p.add_mem h ha
    simp only [sub_add_cancel] at h1
    exact (Ideal.IsPrime.ne_top inferInstance) ((Ideal.eq_top_iff_one _).2 h1)
  apply (IsLocalization.map_eq_zero_iff p.primeCompl (Rp p) a).2
  exact ⟨⟨1-a,hc⟩, by change (1-a)*a=0; rw [sub_mul, one_mul, boolean_identity, sub_self]⟩

/-- Every element of every prime localization is literally 0 or 1. -/
theorem local_dichotomy (z : Rp p) : z=0 ∨ z=1 := by
  obtain ⟨⟨a,s⟩, h⟩ := IsLocalization.surj p.primeCompl z
  rw [image_outside_prime p s s.property, mul_one] at h
  by_cases ha : a ∈ p
  · exact Or.inl (h.trans (image_inside_prime p a ha))
  · exact Or.inr (h.trans (image_outside_prime p a ha))

noncomputable abbrev localField : Field (Rp p) := by
  letI : Nontrivial (Rp p) := IsLocalization.AtPrime.nontrivial _ p
  exact Field.ofIsUnitOrEqZero (fun a => (local_dichotomy p a).elim
    (fun h => Or.inr h) (fun h => Or.inl (h ▸ isUnit_one)))

def localizedQ : LocalizedModule p.primeCompl R →ₗ[Rp p]
    LocalizedModule p.primeCompl C := LocalizedModule.map p.primeCompl q

/-- The usual localized quotient map has an actual linear right inverse at every prime. -/
theorem local_section : ∃ s : LocalizedModule p.primeCompl C →ₗ[Rp p]
    LocalizedModule p.primeCompl R, (localizedQ p).comp s = LinearMap.id := by
  letI : Field (Rp p) := localField p
  set_option synthInstance.maxHeartbeats 100000 in
  apply (localizedQ p).exists_rightInverse_of_surjective
  exact LinearMap.range_eq_top.2 (LocalizedModule.map_surjective p.primeCompl q q_surjective)

open TensorProduct

def tensorQ : (Rp p) ⊗[R] R →ₗ[Rp p] (Rp p) ⊗[R] C :=
  AlgebraTensorModule.lTensor (Rp p) (Rp p) q

/-- The fraction-module localization and the task's tensor localization intertwine the real q. -/
theorem tensorQ_commutes :
    (LocalizedModule.equivTensorProduct p.primeCompl C).toLinearMap.comp (localizedQ p) =
    (tensorQ p).comp (LocalizedModule.equivTensorProduct p.primeCompl R).toLinearMap := by
  apply LinearMap.ext
  intro x
  refine LocalizedModule.induction_on ?_ x
  intro a s
  simp [localizedQ, tensorQ]

theorem tensorQ_surjective : Function.Surjective (tensorQ p) := by
  intro y
  obtain ⟨x,hx⟩ := LocalizedModule.map_surjective p.primeCompl q q_surjective
    ((LocalizedModule.equivTensorProduct p.primeCompl C).symm y)
  refine ⟨LocalizedModule.equivTensorProduct p.primeCompl R x, ?_⟩
  have h := LinearMap.congr_fun (tensorQ_commutes p) x
  change LocalizedModule.equivTensorProduct p.primeCompl C ((localizedQ p) x) =
    tensorQ p (LocalizedModule.equivTensorProduct p.primeCompl R x) at h
  refine h.symm.trans ?_
  change LocalizedModule.equivTensorProduct p.primeCompl C
    (LocalizedModule.map p.primeCompl q x)=y
  rw [hx, LinearEquiv.apply_symm_apply]

/-- A right inverse on the exact tensor-localization objects used in the problem. -/
theorem local_tensor_section : ∃ s : (Rp p) ⊗[R] C →ₗ[Rp p] (Rp p) ⊗[R] R,
    (tensorQ p).comp s = LinearMap.id := by
  letI : Field (Rp p) := localField p
  set_option synthInstance.maxHeartbeats 100000 in
  apply (tensorQ p).exists_rightInverse_of_surjective
  exact LinearMap.range_eq_top.2 (tensorQ_surjective p)

end Local

open TensorProduct

/-- A complete legal counterexample, with actual tensor sections at every prime. -/
theorem counterexample :
    Function.Injective inclusion ∧ Function.Surjective q ∧ Function.Exact inclusion q ∧
    Module.Free R R ∧ Module.Finite R R ∧ Module.Finite R C ∧
    (∀ c : C, ∃ a : R, a • q 1 = c) ∧
    (∀ (p : Ideal R) [p.IsPrime], ∃ s : (Rp p) ⊗[R] C →ₗ[Rp p] (Rp p) ⊗[R] R,
      (tensorQ p).comp s = LinearMap.id) ∧
    ¬ ∃ s : C →ₗ[R] R, q.comp s = LinearMap.id :=
  ⟨inclusion_injective, q_surjective, row_exact, inferInstance, inferInstance,
    quotient_finitely_generated, cyclic, fun p _ => local_tensor_section p, no_global_section⟩

end MathGauge.LocalSplitting
