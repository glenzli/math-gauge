theorem MathGauge.ConvexCost.reconstruct_maximal_ereal_of_isClosed_real_epigraph.{u_1} : ∀ {E : Type u_1}
  [inst : AddCommGroup E] [inst_1 : Module ℝ E] [inst_2 : TopologicalSpace E] [IsTopologicalAddGroup E]
  [ContinuousSMul ℝ E] [LocallyConvexSpace ℝ E] {f : E → ENNReal},
  MathGauge.ConvexCost.ConvexCost f →
    (∃ x, f x ≠ ⊤) →
      ∀ (h : E → EReal),
        IsClosed {p | h p.1 ≤ ↑p.2} →
          (∀ (x : E), h x ≤ ↑(f x)) → ∀ (x : E), h x ≤ ↑(MathGauge.ConvexCost.reconstruct f x) :=
fun {E} [AddCommGroup E] [Module ℝ E] [TopologicalSpace E] [IsTopologicalAddGroup E] [ContinuousSMul ℝ E]
    [LocallyConvexSpace ℝ E] {f} hf hp h hclosed hle =>
  have hsub :=
    closure_minimal
      (fun ⦃p⦄ hp' =>
        have he :=
          Eq.mpr (id (congrArg (fun _a => _a = ↑p.2) EReal.coe_ennreal_ofReal))
            (Eq.mpr (id (congrArg (fun _a => ↑_a = ↑p.2) (max_eq_left hp'.left))) (Eq.refl ↑p.2));
        LE.le.trans (hle p.1) (he ▸ EReal.coe_ennreal_le_coe_ennreal_iff.mpr hp'.right))
      hclosed;
  fun x =>
  Eq.mpr (id (congrArg (fun _a => h x ≤ ↑(_a x)) (MathGauge.ConvexCost.reconstruct_eq_affineHull f)))
    (if hx : MathGauge.ConvexCost.affineHull f x = ⊤ then
      of_eq_true (Eq.trans (congrArg (LE.le (h x)) (congrArg ENNReal.toEReal hx)) le_top._simp_2)
    else
      have hm := ⟨ENNReal.toReal_nonneg, Eq.ge (ENNReal.ofReal_toReal hx)⟩;
      Eq.mp (congrArg (LE.le (h x)) (EReal.coe_ennreal_toReal hx))
        (hsub
          (Eq.mp
            (congrArg (fun _a => (x, (MathGauge.ConvexCost.affineHull f x).toReal) ∈ _a)
              (MathGauge.ConvexCost.epigraph_affineHull_eq_closure hf hp))
            hm)))
'MathGauge.ConvexCost.reconstruct_maximal_ereal_of_isClosed_real_epigraph' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
'MathGauge.ConvexCost.reconstruct_maximal_ereal' depends on axioms: [propext, Classical.choice, Quot.sound]
