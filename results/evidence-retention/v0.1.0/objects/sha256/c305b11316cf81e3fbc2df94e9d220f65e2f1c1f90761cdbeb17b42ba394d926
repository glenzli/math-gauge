def channelCoeff {I : Type} (M : ChannelMatrix I) (c : ComponentChannel I) : ENNReal :=
  M c.1 c.2

/--
OET anchor: oet-7fa97eb6e24d5527 (CH02-D07)
**定义（单输入通道行稀疏）**：
矩阵 $\mathbf{M}$ 在输出行 $j$ 处除输入分量 $i$ 对应的条目 $M_{i \to j}$ 外均为零：
$\forall k \neq i,\ M_{k \to j} = 0$。
-/
def IsSingleInputRow {I : Type} (M : ChannelMatrix I) (i j : I) : Prop :=
  ∀ k : I, k ≠ i → M k j = 0

/--
OET anchor: oet-7fa97eb6e24d5527 (CH02-D07)
**定义（对角输入项行稀疏）**：
矩阵 $\mathbf{M}$ 在输出行 $j$ 处只保留同分量对角输入项 $M_{j \to j}$：
$\forall k \neq j,\ M_{k \to j} = 0$。
-/
def IsDiagonalInputRow {I : Type} (M : ChannelMatrix I) (j : I) : Prop :=
  IsSingleInputRow M j j

/--
OET anchor: oet-7fa97eb6e24d5527 (CH02-D07)
**定义（对角通道矩阵）**：
所有异分量通道 $(i, j)$（$i \neq j$）的条目均为零：$\forall i \neq j,\ M_{i \to j} = 0$。
-/
def IsDiagonalChannelMatrix {I : Type} (M : ChannelMatrix I) : Prop :=
  ∀ i j : I, i ≠ j → M i j = 0

/--
OET anchor: oet-7fa97eb6e24d5527 (CH02-D07)
矩阵为对角通道矩阵，当且仅当每个输出行 $j$ 都只保留同分量通道 $(j, j)$。
-/
theorem isDiagonalChannelMatrix_iff_forall_isSingleInputRow {I : Type} (M : ChannelMatrix I) :
    IsDiagonalChannelMatrix M ↔ ∀ j : I, IsSingleInputRow M j j := by
  constructor
  · intro h j k hkj
    exact h k j hkj
  · intro h i j hij
    exact h j i hij

/--
OET anchor: oet-7fa97eb6e24d5527 (CH02-D07)
通道矩阵为对角通道矩阵，当且仅当其对应的输出行/输入列矩阵在所有非对角位置 `(j, i)`（`j ≠ i`）处为零。
-/
theorem isDiagonalChannelMatrix_iff_toRowColMatrix_offDiag_zero {I : Type} (M : ChannelMatrix I) :
    IsDiagonalChannelMatrix M ↔ ∀ j i : I, j ≠ i → toRowColMatrix M j i = 0 := by
  constructor
  · intro h j i hji
    exact h i j (Ne.symm hji)
  · intro h i j hij
    exact h j i (Ne.symm hij)

/-! ## CH02-P19：单一输入项行化简；包含对角特例 -/

/--
OET anchor: oet-7fa97eb6e24d5527 (CH02-P19)
**单一输入项行求和化简**：
若第 $j$ 行除 $L_{i \to j}$ 外均为零，则 $\sum_{k \in I} L_{k \to j} d_k(x, y) = L_{i \to j} d_i(x, y)$。
-/
theorem singleInputRow_sum_eq {X I : Type} [Fintype I]
    (d : I → X → X → ENNReal) (L : ChannelMatrix I) (i j : I)
    (h_row : IsSingleInputRow L i j) (x y : X) :
    (∑ k : I, L k j * d k x y) = L i j * d i x y := by
  refine Finset.sum_eq_single i ?_ ?_
  · intro k _ hki
    rw [h_row k hki, zero_mul]
  · intro hi_not_mem
    exact False.elim (hi_not_mem (Finset.mem_univ i))

/--
OET anchor: oet-7fa97eb6e24d5527 (CH02-P19)
**单一输入项行 Lip 不等式化简**：
设 $\mathbf{L} \in \mathscr{L}(\phi)\big|_U$。若第 $j$ 行除 $L_{i \to j}$ 外均为零，则对任意 $x, y \in U$，
$d_j(\phi(x), \phi(y)) \le \sum_{k \in I} L_{k \to j} d_k(x, y) = L_{i \to j} d_i(x, y)$。
-/
theorem singleInputRow_lip_bound {X I : Type} {bot : X} [Fintype I]
    (d : I → X → X → ENNReal) (ϕ : Operator X bot) (U : Set X)
    (L : ChannelMatrix I) (i j : I)
    (hL : L ∈ RestrictedLipCertFamily d ϕ U)
    (h_row : IsSingleInputRow L i j) :
    ∀ x ∈ U, ∀ y ∈ U,
      d j (ϕ.func x) (ϕ.func y) ≤ ∑ k : I, L k j * d k x y ∧
      (∑ k : I, L k j * d k x y) = L i j * d i x y ∧
      d j (ϕ.func x) (ϕ.func y) ≤ L i j * d i x y := by
  intro x hx y hy
  have h_sum : (∑ k : I, L k j * d k x y) = L i j * d i x y :=
    singleInputRow_sum_eq d L i j h_row x y
  have h_lip : d j (ϕ.func x) (ϕ.func y) ≤ ∑ k : I, L k j * d k x y :=
    hL.2 x hx y hy j
  exact ⟨h_lip, h_sum, h_sum ▸ h_lip⟩

/--
OET anchor: oet-7fa97eb6e24d5527 (CH02-P19)
**单一输入项行 Lip 标量上界**：
若 $\mathbf{L} \in \mathscr{L}(\phi)\big|_U$ 且第 $j$ 行除 $L_{i \to j}$ 外均为零，则对任意 $x, y \in U$，
$d_j(\phi(x), \phi(y)) \le L_{i \to j} d_i(x, y)$。
-/
theorem singleInputRow_lip_le {X I : Type} {bot : X} [Fintype I]
    (d : I → X → X → ENNReal) (ϕ : Operator X bot) (U : Set X)
    (L : ChannelMatrix I) (i j : I)
    (hL : L ∈ RestrictedLipCertFamily d ϕ U)
    (h_row : IsSingleInputRow L i j) :
    ∀ x ∈ U, ∀ y ∈ U,
      d j (ϕ.func x) (ϕ.func y) ≤ L i j * d i x y :=
  fun x hx y hy => (singleInputRow_lip_bound d ϕ U L i j hL h_row x hx y hy).2.2

/--
OET anchor: oet-7fa97eb6e24d5527 (CH02-P19)
**对角 Lip 矩阵特例**：
若 $\mathbf{L} \in \mathscr{L}(\phi)\big|_U$ 为对角矩阵，则对每个同分量通道 $(i, i)$ 及任意 $x, y \in U$，
$\sum_{k \in I} L_{k \to i} d_k(x, y) = L_{i \to i} d_i(x, y)$ 且
$d_i(\phi(x), \phi(y)) \le L_{i \to i} d_i(x, y)$。
-/
theorem diagonal_lip_bound {X I : Type} {bot : X} [Fintype I]
    (d : I → X → X → ENNReal) (ϕ : Operator X bot) (U : Set X)
    (L : ChannelMatrix I)
    (hL : L ∈ RestrictedLipCertFamily d ϕ U)
    (h_diag : IsDiagonalChannelMatrix L) :
    ∀ i : I, ∀ x ∈ U, ∀ y ∈ U,
      (∑ k : I, L k i * d k x y) = L i i * d i x y ∧
      d i (ϕ.func x) (ϕ.func y) ≤ L i i * d i x y := by
  intro i x hx y hy
  have h_row : IsSingleInputRow L i i :=
    (isDiagonalChannelMatrix_iff_forall_isSingleInputRow L).mp h_diag i
  have h := singleInputRow_lip_bound d ϕ U L i i hL h_row x hx y hy
  exact ⟨h.2.1, h.2.2⟩

/-! ## CH02-P20：正 co-Lip 通道保持正距离 -/

/--
OET anchor: oet-f82672ec0dd48f28 (CH02-P20)
**单通道 co-Lip 下界引理**：
若 $\mathbf{K} \in \mathscr{K}(\phi)\big|_U$，则对任意通道 $(i, j)$ 与 $x, y \in U$，
$K_{i \to j} d_i(x, y) \le \sum_{k \in I} K_{k \to j} d_k(x, y) \le d_j(\phi(x), \phi(y))$。
-/
theorem single_channel_coLip_le {X I : Type} {bot : X} [Fintype I]
    (d : I → X → X → ENNReal) (ϕ : Operator X bot) (U : Set X)
    (K : ChannelMatrix I) (i j : I)
    (hK : K ∈ RestrictedCoLipCertFamily d ϕ U) :
    ∀ x ∈ U, ∀ y ∈ U,
      K i j * d i x y ≤ d j (ϕ.func x) (ϕ.func y) := by
  intro x hx y hy
  have h_single : K i j * d i x y ≤ ∑ k : I, K k j * d k x y :=
    Finset.single_le_sum (fun k _ => zero_le (K k j * d k x y)) (Finset.mem_univ i)
  exact le_trans h_single (hK.2.2 x hx y hy j)

/--
OET anchor: oet-f82672ec0dd48f28 (CH02-P20)
**命题 2.8 (i)（正 co-Lip 通道保持可分辨性 / 正距离）**：
设 $\mathbf{K} \in \mathscr{K}(\phi)\big|_U$。若 $K_{i \to j} > 0$，则对任意 $x, y \in U$，
$d_i(x, y) > 0 \implies d_j(\phi(x), \phi(y)) > 0$。
-/
theorem pos_coLip_channel_preserves_pos_dist {X I : Type} {bot : X} [Fintype I]
    (d : I → X → X → ENNReal) (ϕ : Operator X bot) (U : Set X)
    (K : ChannelMatrix I) (i j : I)
    (hK : K ∈ RestrictedCoLipCertFamily d ϕ U)
    (hKij : 0 < K i j) :
    ∀ x ∈ U, ∀ y ∈ U,
      0 < d i x y → 0 < d j (ϕ.func x) (ϕ.func y) := by
  intro x hx y hy hd
  have h_prod_pos : 0 < K i j * d i x y :=
    ENNReal.mul_pos hKij.ne' hd.ne'
  have h_le : K i j * d i x y ≤ d j (ϕ.func x) (ϕ.func y) :=
    single_channel_coLip_le d ϕ U K i j hK x hx y hy
  exact lt_of_lt_of_le h_prod_pos h_le

/--
OET anchor: oet-88784dcbfff0ea66 (CH02-D02, CH02-P20)
**注（co-Lip 条目为零的充分条件）**：
若存在 $x, y \in U$ 使 $d_j(\phi(x), \phi(y)) = 0$ 且 $d_i(x, y) > 0$，
则任一 $\mathbf{K} \in \mathscr{K}(\phi)\big|_U$ 必满足 $K_{i \to j} = 0$。
-/
theorem coLip_entry_eq_zero_of_dist_zero_of_pos {X I : Type} {bot : X} [Fintype I]
    (d : I → X → X → ENNReal) (ϕ : Operator X bot) (U : Set X)
    (K : ChannelMatrix I) (i j : I)
    (hK : K ∈ RestrictedCoLipCertFamily d ϕ U)
    {x y : X} (hx : x ∈ U) (hy : y ∈ U)
    (h_out : d j (ϕ.func x) (ϕ.func y) = 0)
    (h_in : 0 < d i x y) :
    K i j = 0 := by
  by_contra hK_ne
  have hK_pos : 0 < K i j := pos_iff_ne_zero.mpr hK_ne
  have h_pos := pos_coLip_channel_preserves_pos_dist d ϕ U K i j hK hK_pos x hx y hy h_in
  exact h_pos.ne' h_out

/-! ## CH02-P21：全对角正 co-Lip 反射族零距；不加强为点相等 -/

/--
OET anchor: oet-f82672ec0dd48f28 (CH02-P21)
**命题 2.8 (ii)（全对角正 co-Lip 反射族零距关系）**：
设 $\mathbf{K} \in \mathscr{K}(\phi)\big|_U$。若对所有 $j \in I$ 均有 $K_{j \to j} > 0$，
则 $\phi$ 在 $U$ 上反射族零距关系：对任意 $x, y \in U$，
$\phi(x) \sim_{\mathcal{G}} \phi(y) \implies x \sim_{\mathcal{G}} y$。
（严格保持正文非分离规范空间的结论强度 `GaugeZeroRelated d x y`，不加强为点相等 `x = y`。）
-/
theorem diag_pos_coLip_reflects_gaugeZeroRelated {X I : Type} {bot : X} [Fintype I]
    (d : I → X → X → ENNReal) (ϕ : Operator X bot) (U : Set X)
    (K : ChannelMatrix I)
    (hK : K ∈ RestrictedCoLipCertFamily d ϕ U)
    (h_diag_pos : ∀ j : I, 0 < K j j) :
    ∀ x ∈ U, ∀ y ∈ U,
      GaugeZeroRelated d (ϕ.func x) (ϕ.func y) → GaugeZeroRelated d x y := by
  intro x hx y hy h_phi_zero j
  by_contra h_ne_zero
  have hd_pos : 0 < d j x y := pos_iff_ne_zero.mpr h_ne_zero
  have h_out_pos : 0 < d j (ϕ.func x) (ϕ.func y) :=
    pos_coLip_channel_preserves_pos_dist d ϕ U K j j hK (h_diag_pos j) x hx y hy hd_pos
  exact h_out_pos.ne' (h_phi_zero j)

/-! ## CH02-P25：习题 2.2：标量双侧界 -/

/--
OET anchor: oet-6a98a58b5bc95360 (CH02-P25)
**习题 2.2（对角输入项的标量双侧界）**：
设 $\phi \in \mathcal{X}_{\mathrm{op}}$，$U \subseteq \mathrm{dom}(\phi)$，$j \in I$。
给定 $\mathbf{L} \in \mathscr{L}(\phi)\big|_U$ 与 $\mathbf{K} \in \mathscr{K}(\phi)\big|_U$。
若 $\phi$ 在 $U$ 上关于输出分量 $d_j$ 满足只保留对角输入项的 Lip 上界
$L_{k \to j} = 0\ (\forall k \neq j)$，
则对任意 $x, y \in U$ 有标量双侧不等式：
$K_{j \to j} \cdot d_j(x, y) \le d_j(\phi(x), \phi(y)) \le L_{j \to j} \cdot d_j(x, y)$。
-/
theorem exercise_2_2_scalar_two_sided_bound {X I : Type} {bot : X} [Fintype I]
    (d : I → X → X → ENNReal) (ϕ : Operator X bot) (U : Set X) (j : I)
    (L K : ChannelMatrix I)
    (_hU : U ⊆ dom ϕ)
    (hL : L ∈ RestrictedLipCertFamily d ϕ U)
    (hK : K ∈ RestrictedCoLipCertFamily d ϕ U)
    (hL_diag_row : IsSingleInputRow L j j) :
    ∀ x ∈ U, ∀ y ∈ U,
      K j j * d j x y ≤ d j (ϕ.func x) (ϕ.func y) ∧
      d j (ϕ.func x) (ϕ.func y) ≤ L j j * d j x y := by
  intro x hx y hy
  have h_lower : K j j * d j x y ≤ d j (ϕ.func x) (ϕ.func y) :=
    single_channel_coLip_le d ϕ U K j j hK x hx y hy
  have h_upper : d j (ϕ.func x) (ϕ.func y) ≤ L j j * d j x y :=
    singleInputRow_lip_le d ϕ U L j j hL hL_diag_row x hx y hy
  exact ⟨h_lower, h_upper⟩
