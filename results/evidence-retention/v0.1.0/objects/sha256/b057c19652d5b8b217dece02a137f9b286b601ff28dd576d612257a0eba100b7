theorem finite_comp_lip_bound {X I : Type} {bot : X} [Fintype I] [DecidableEq I]
    (d : I → X → X → ENNReal)
    (ϕs : List (Operator X bot)) (h_ne : ϕs ≠ [])
    (Ls : List (GaugeMatrix I)) (h_len : Ls.length = ϕs.length)
    {U₁ : Set X} (hU₁ : U₁ ⊆ dom (stepChain ϕs))
    (h_certs : ∀ m : Fin ϕs.length,
      Ls.get (m.cast h_len.symm) ∈
        RestrictedLipCertFamily d (ϕs.get m) (intermediateImage ϕs U₁ m.val)) :
    matChainProd Ls ∈ RestrictedLipCertFamily d (stepChain ϕs) U₁ := by
  induction ϕs generalizing Ls U₁ with
  | nil =>
      exact False.elim (h_ne rfl)
  | cons ϕ₁ tail ih =>
      cases Ls with
      | nil =>
          simp at h_len
      | cons L₁ Ltail =>
          cases tail with
          | nil =>
              have hLtail : Ltail = [] := List.eq_nil_of_length_eq_zero (Nat.succ.inj h_len)
              subst hLtail
              have h0 := h_certs ⟨0, Nat.zero_lt_one⟩
              simpa [matChainProd, stepChain, intermediateImage] using h0
          | cons ϕ₂ tail' =>
              have hL₁ : L₁ ∈ RestrictedLipCertFamily d ϕ₁ U₁ := by
                simpa [intermediateImage] using h_certs ⟨0, Nat.zero_lt_succ _⟩
              rcases dom_operator_compose_subset (stepChain (ϕ₂ :: tail')) ϕ₁ hU₁ with
                ⟨_, hU₂_dom⟩
              have h_len_tail : Ltail.length = (ϕ₂ :: tail').length := Nat.succ.inj h_len
              have h_tail_certs :
                  ∀ m : Fin (ϕ₂ :: tail').length,
                    Ltail.get (m.cast h_len_tail.symm) ∈
                      RestrictedLipCertFamily d ((ϕ₂ :: tail').get m)
                        (intermediateImage (ϕ₂ :: tail') (operator_image ϕ₁ U₁) m.val) := by
                intro m
                have hm := h_certs m.succ
