theorem global_lip_subset_restricted_lip {X I : Type} {bot : X} [Fintype I]
    (d : I → X → X → ENNReal) (ϕ : Operator X bot) {U : Set X}
    (hU : U ⊆ dom ϕ) :
    LipCertFamily d ϕ ⊆ RestrictedLipCertFamily d ϕ U := by
  rw [lipCertFamily_eq_restricted_dom]
