theorem colip_entry_eq_zero_of_restricted {X I : Type} {bot : X} [Fintype I]
    (d : I → X → X → ENNReal) (ϕ : Operator X bot) {U : Set X}
    {K : GaugeMatrix I} (hK : K ∈ RestrictedCoLipCertFamily d ϕ U)
    {x y : X} (hx : x ∈ U) (hy : y ∈ U) {i j : I}
    (h_out_zero : d j (ϕ.func x) (ϕ.func y) = 0)
    (h_in_pos : d i x y > 0) :
    K i j = 0 := by
  have h_le_sum : K i j * d i x y ≤ ∑ k : I, K k j * d k x y :=
    Finset.single_le_sum (fun k _ => zero_le (K k j * d k x y)) (Finset.mem_univ i)
  have h_sum_le : ∑ k : I, K k j * d k x y ≤ d j (ϕ.func x) (ϕ.func y) :=
    hK.2.2 x hx y hy j
  have h_prod_zero : K i j * d i x y = 0 := by
    apply le_antisymm _ (zero_le _)
    calc
      K i j * d i x y ≤ ∑ k : I, K k j * d k x y := h_le_sum
      _ ≤ d j (ϕ.func x) (ϕ.func y) := h_sum_le
      _ = 0 := h_out_zero
  rcases mul_eq_zero.mp h_prod_zero with hK_zero | hd_zero
  · exact hK_zero
  · exact False.elim ((ne_of_gt h_in_pos) hd_zero)

