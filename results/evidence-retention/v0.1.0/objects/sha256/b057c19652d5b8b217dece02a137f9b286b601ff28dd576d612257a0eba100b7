theorem single_component_lip_iff {X I : Type} {bot : X} [Fintype I]
    (d : I → X → X → ENNReal) (ϕ : Operator X bot) (L : GaugeMatrix I)
    (i₀ : I) (hI : ∀ j : I, j = i₀) :
    IsLipMatrix d ϕ L ↔
      ∀ x ∈ dom ϕ, ∀ y ∈ dom ϕ, d i₀ (ϕ.func x) (ϕ.func y) ≤ L i₀ i₀ * d i₀ x y := by
  have huniv : (Finset.univ : Finset I) = {i₀} := by
    ext j
    simp [hI j]
  constructor
  · intro h x hx y hy
    have h_step := h x hx y hy i₀
    simpa [huniv] using h_step
  · intro h x hx y hy j
    rw [hI j, huniv, Finset.sum_singleton]
    exact h x hx y hy

/-- 单分量情形下受限 Lip 矩阵条件退化为标量不等式。 -/
theorem single_component_restricted_lip_iff {X I : Type} {bot : X} [Fintype I]
    (d : I → X → X → ENNReal) (ϕ : Operator X bot) (U : Set X) (L : GaugeMatrix I)
    (i₀ : I) (hI : ∀ j : I, j = i₀) :
    IsRestrictedLipMatrix d ϕ U L ↔
      U ⊆ dom ϕ ∧ ∀ x ∈ U, ∀ y ∈ U, d i₀ (ϕ.func x) (ϕ.func y) ≤ L i₀ i₀ * d i₀ x y := by
  have huniv : (Finset.univ : Finset I) = {i₀} := by
    ext j
    simp [hI j]
  constructor
  · rintro ⟨hU, h⟩
    refine ⟨hU, fun x hx y hy => ?_⟩
    have h_step := h x hx y hy i₀
    simpa [huniv] using h_step
  · rintro ⟨hU, h⟩
    refine ⟨hU, fun x hx y hy j => ?_⟩
    rw [hI j, huniv, Finset.sum_singleton]
    exact h x hx y hy

/--
