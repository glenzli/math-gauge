**命题 2.2（Lip 矩阵复合律）**
对于复合算子 $\phi_2 \circ \phi_1$，选定起始定义域的局部子集 $U_1 \subseteq \mathrm{dom}(\phi_2 \circ \phi_1)$，
记像集 $U_2 = \phi_1(U_1)$。若 $\mathbf{L}^{(1)} \in \mathscr{L}(\phi_1)\big|_{U_1}$ 且
$\mathbf{L}^{(2)} \in \mathscr{L}(\phi_2)\big|_{U_2}$，则
$$\mathbf{L}^{(2)} \cdot \mathbf{L}^{(1)} \in \mathscr{L}(\phi_2 \circ \phi_1)\big|_{U_1}.$$
-/
theorem lip_matrix_comp {X I : Type} {bot : X} [Fintype I]
    (d : I → X → X → ENNReal) (ϕ₂ ϕ₁ : Operator X bot)
    {U₁ : Set X} (hU₁ : U₁ ⊆ dom (operator_compose ϕ₂ ϕ₁))
    {L₁ L₂ : GaugeMatrix I}
    (hL₁ : L₁ ∈ RestrictedLipCertFamily d ϕ₁ U₁)
    (hL₂ : L₂ ∈ RestrictedLipCertFamily d ϕ₂ (operator_image ϕ₁ U₁)) :
    matMul L₂ L₁ ∈ RestrictedLipCertFamily d (operator_compose ϕ₂ ϕ₁) U₁ := by
  refine ⟨hU₁, ?_⟩
  intro x hx y hy j
  have hx₂ : ϕ₁.func x ∈ operator_image ϕ₁ U₁ := ⟨x, hx, rfl⟩
  have hy₂ : ϕ₁.func y ∈ operator_image ϕ₁ U₁ := ⟨y, hy, rfl⟩
  have step₂ :
      d j ((operator_compose ϕ₂ ϕ₁).func x) ((operator_compose ϕ₂ ϕ₁).func y) ≤
        ∑ k : I, L₂ k j * d k (ϕ₁.func x) (ϕ₁.func y) :=
    hL₂.2 (ϕ₁.func x) hx₂ (ϕ₁.func y) hy₂ j
  have step₁ :
      ∑ k : I, L₂ k j * d k (ϕ₁.func x) (ϕ₁.func y) ≤
        ∑ k : I, L₂ k j * (∑ i : I, L₁ i k * d i x y) := by
    apply Finset.sum_le_sum
    intro k _
    exact mul_le_mul_of_nonneg_left (hL₁.2 x hx y hy k) (zero_le _)
  have h_rearrange :
      (∑ k : I, L₂ k j * (∑ i : I, L₁ i k * d i x y)) =
        ∑ i : I, matMul L₂ L₁ i j * d i x y := by
    simp only [matMul_apply, Finset.mul_sum, Finset.sum_mul, mul_assoc]
    rw [Finset.sum_comm]
  exact le_trans step₂ (h_rearrange ▸ step₁)

/--
