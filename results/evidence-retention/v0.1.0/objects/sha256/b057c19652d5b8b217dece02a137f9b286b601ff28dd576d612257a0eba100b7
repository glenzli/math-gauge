theorem intermediateImage_subset_dom {X : Type} {bot : X}
    (ϕs : List (Operator X bot)) {U₁ : Set X}
    (hU₁ : U₁ ⊆ dom (stepChain ϕs)) (m : Fin ϕs.length) :
    intermediateImage ϕs U₁ m.val ⊆ dom (ϕs.get m) := by
  induction ϕs generalizing U₁ with
  | nil =>
      exact Fin.elim0 m
  | cons ϕ tail ih =>
      rcases dom_operator_compose_subset (stepChain tail) ϕ hU₁ with ⟨h_dom_head, h_dom_tail⟩
      refine Fin.cases ?_ ?_ m
      · simpa [intermediateImage] using h_dom_head
      · intro m'
        simpa [intermediateImage] using ih h_dom_tail m'

