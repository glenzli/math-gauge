-/
theorem dom_operator_compose_subset {X : Type} {bot : X}
    (ϕ₂ ϕ₁ : Operator X bot) {U₁ : Set X}
    (hU₁ : U₁ ⊆ dom (operator_compose ϕ₂ ϕ₁)) :
    U₁ ⊆ dom ϕ₁ ∧ operator_image ϕ₁ U₁ ⊆ dom ϕ₂ := by
  constructor
  · intro x hx hbot
    have hx_comp : (operator_compose ϕ₂ ϕ₁).func x ≠ bot := hU₁ hx
    apply hx_comp
    change ϕ₂.func (ϕ₁.func x) = bot
    rw [hbot, ϕ₂.preserves_bot]
  · rintro y ⟨x, hx, rfl⟩
    exact hU₁ hx

