    {
      "id": "ENG-001",
      "priority": "P2",
      "title": "Candidate Lean receipt does not bind the frozen group contract",
      "locations": [
        {
          "path": "math_gauge/execution.py",
          "start": 515,
          "end": 536
        },
        {
          "path": "math_gauge/execution.py",
          "start": 556,
          "end": 565
        },
        {
          "path": "math_gauge/review.py",
          "start": 115,
          "end": 124
        }
      ],
      "trigger": "Two runs have byte-identical candidate request and response but different evaluator-only group contracts, such as different required_output_files or immutable_input_files.",
      "observed": "The generated receipt and artifact manifest omit group_contract_sha256. Group review accepts matching request/response receipt hashes without checking which contract the verifier enforced. A synthetic receipt containing only Other.lean is accepted for all five mandatory stages of a stronger contract requiring Main.lean.",
      "impact": "A compilation receipt reused from a weaker contract can bypass stronger per-contract delivery constraints even though each run separately freezes its contract. No actual current model result is shown affected.",
      "evidence": "contract-probes.json: cross_contract_receipt; contract-probes.py; source inspection",
      "evidence_kind": "Synthetic acceptance-path probe and source inspection; no compilation or mathematical judgment.",
      "suggested_fix": "Include the exact frozen group_contract_sha256 in candidate report and candidate artifact manifest, and require equality with the run/record/entry contract binding when consuming the receipt. Preserve backward compatibility only for non-group legacy receipts.",
      "status": "reported_only_not_fixed"
    },
    {
      "id": "ENG-002",
      "priority": "P2",
      "title": "Base inspection and reporting do not recheck frozen candidate input",
      "locations": [
        {
          "path": "math_gauge/review.py",
          "start": 10,
          "end": 30
        }
      ],
      "trigger": "solver/request.json changes after execution while response and group contract remain unchanged.",
      "observed": "inspect_run validates response and frozen group contract only. templates, apply_reviews and report accept the changed request and existing review; the probe obtains a full five-stage diagnostic after its stored request SHA256 differs from actual request bytes.",
      "impact": "A standalone archived review/report can appear valid despite lost or changed original candidate input. The paired compare_models path has a separate correct request/message hash check at review.py:461-471, so this finding does not establish a bypass of that path.",
      "evidence": "contract-probes.json: changed_request_report; contract-probes.py; source inspection",
      "evidence_kind": "Synthetic offline mutation probe; fixture data excluded from model comparison.",
      "suggested_fix": "Recompute the canonical request SHA256 and candidate-message SHA256 in inspect_run, check case/version/track identity, and compare them with the execution record and run metadata before exposing review/report operations.",
      "status": "reported_only_not_fixed"
    }
