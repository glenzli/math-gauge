{
  "case_id": "HCH02",
  "version": "0.1.0",
  "items": [
    {"id":"HC02-D01","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.lipOn"},{"file":"OperatorBounds.lean","name":"HCH02.lip"},{"file":"OperatorBounds.lean","name":"HCH02.act_top"}],"representation":"矩阵和分量距均为 ENNReal。lipOn 要求 U⊆dom φ，并遍历 U 的每个点对及每个输出分量；lip 取 U=dom φ。act_top 覆盖无穷系数遇零距或正距的两种情况。","dependencies":["HC02-D03"]},
    {"id":"HC02-D02","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.coLipOn"},{"file":"OperatorBounds.lean","name":"HCH02.coLip_term"}],"representation":"下界证书族是矩阵集合，成员同时要求 U 非空、U⊆dom φ 和所有点对、输出分量上的下界。coLip_term 由全和下界推出单项下界。","dependencies":["HC02-D03"]},
    {"id":"HC02-D03","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.Coeff"},{"file":"OperatorBounds.lean","name":"HCH02.display"},{"file":"OperatorBounds.lean","name":"HCH02.display_apply"},{"file":"OperatorBounds.lean","name":"HCH02.mul"},{"file":"OperatorBounds.lean","name":"HCH02.display_mul"},{"file":"OperatorBounds.lean","name":"HCH02.act"},{"file":"OperatorBounds.lean","name":"HCH02.act_mono"},{"file":"OperatorBounds.lean","name":"HCH02.act_mul"}],"representation":"M i j 按输入 i、输出 j 存储。display 的第 j 行第 i 列取 M i j，display_mul 证明乘法对应通常的矩阵乘法。act 是固定输出的有限和。","dependencies":[]},
    {"id":"HC02-D04","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.unit"},{"file":"OperatorBounds.lean","name":"HCH02.unit_apply"},{"file":"OperatorBounds.lean","name":"HCH02.unit_mul"},{"file":"OperatorBounds.lean","name":"HCH02.mul_unit"},{"file":"OperatorBounds.lean","name":"HCH02.act_unit"},{"file":"OperatorBounds.lean","name":"HCH02.product"},{"file":"OperatorBounds.lean","name":"HCH02.product_nil"},{"file":"OperatorBounds.lean","name":"HCH02.product_cons"},{"file":"OperatorBounds.lean","name":"HCH02.product_single"}],"representation":"unit 是 Kronecker δ。列表从先施行的矩阵开始，递推把首矩阵乘在尾部乘积右侧。空乘积为单位，单步乘积为该矩阵。","dependencies":["HC02-D03"]},
    {"id":"HC02-D05","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.identity"},{"file":"OperatorBounds.lean","name":"HCH02.comp"},{"file":"OperatorBounds.lean","name":"HCH02.comp_domains"},{"file":"OperatorBounds.lean","name":"HCH02.chain"},{"file":"OperatorBounds.lean","name":"HCH02.iterImage"},{"file":"OperatorBounds.lean","name":"HCH02.iterImage_eq"},{"file":"OperatorBounds.lean","name":"HCH02.Step"},{"file":"OperatorBounds.lean","name":"HCH02.inputAt"},{"file":"OperatorBounds.lean","name":"HCH02.inputAt_succ"},{"file":"OperatorBounds.lean","name":"HCH02.inputAt_last"},{"file":"OperatorBounds.lean","name":"HCH02.Stepwise"},{"file":"OperatorBounds.lean","name":"HCH02.stepwise_cons"},{"file":"OperatorBounds.lean","name":"HCH02.step_domains"},{"file":"OperatorBounds.lean","name":"HCH02.stepsOfFn"},{"file":"OperatorBounds.lean","name":"HCH02.stepwise_ofFn_iff"}],"representation":"Step 配对算子和矩阵。Lean 下标 m 对应正文第 m+1 步，inputAt 取前 m 步的像。逐步像递推、末端像等式与各步定义域包含均有证明，Stepwise 只量化各步的局部条件。 stepsOfFn 从逐步索引数据构造列表，stepwise_ofFn_iff 证明其局部条件与逐步量词等价。","dependencies":["HC02-D03"]},
    {"id":"HC02-D06","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.pathEntries"},{"file":"OperatorBounds.lean","name":"HCH02.pathWeight"},{"file":"OperatorBounds.lean","name":"HCH02.HasZero"},{"file":"OperatorBounds.lean","name":"HCH02.AllPositive"},{"file":"OperatorBounds.lean","name":"HCH02.pathEntries_zip"},{"file":"OperatorBounds.lean","name":"HCH02.pathEntries_length"},{"file":"OperatorBounds.lean","name":"HCH02.emptyPath"},{"file":"OperatorBounds.lean","name":"HCH02.single_path"}],"representation":"头矩阵加长度为 n−1 的尾列表表示 n 步。Fin (n−1) → I 遍历全部中间序列。pathEntries_zip 按相邻顶点和层级对齐条目，权重取乘积，两个谓词分别检查有零与全正；单步中间序列唯一。","dependencies":["HC02-D03"]},
    {"id":"HC02-D07","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.Channel"},{"file":"OperatorBounds.lean","name":"HCH02.Row"},{"file":"OperatorBounds.lean","name":"HCH02.Col"},{"file":"OperatorBounds.lean","name":"HCH02.Diagonal"},{"file":"OperatorBounds.lean","name":"HCH02.RowDecoupled"},{"file":"OperatorBounds.lean","name":"HCH02.ColDecoupled"}],"representation":"通道为输入输出有序对。Row 固定输出并允许指定输入位置，Col 固定输入并允许指定输出位置。解耦要求存在合法 Lip 证书及该位置，Diagonal 要求所有非对角项为零。","dependencies":["HC02-D01","HC02-D03"]},
    {"id":"HC02-D08","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.scalarFeasible"},{"file":"OperatorBounds.lean","name":"HCH02.scalar_mem_iff"},{"file":"OperatorBounds.lean","name":"HCH02.channelLip"},{"file":"OperatorBounds.lean","name":"HCH02.channelLip_empty"}],"representation":"对合法 U，scalar_mem_iff 把可行性化为所有点对的单输入、单输出标量不等式。channelLip 取该标量集合的下确界，空集值为 ⊤。","dependencies":["HC02-D07"]},
    {"id":"HC02-P01","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.lip_single"}],"representation":"Subsingleton I 和指定 i 表示 I={i}，求和只留下 i 项，给出全域证书与标量界的双向等价。","dependencies":["HC02-D01","HC02-D03"]},
    {"id":"HC02-P02","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.lip_restrict"}],"representation":"以 V=dom φ 特化限制定理，得到 U⊆dom φ 时的全域证书包含。","dependencies":["HC02-D01","HC02-P03"]},
    {"id":"HC02-P03","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.lip_shrink"}],"representation":"若 U⊆V，且矩阵在 V 上合法，则把定义域包含和所有点对条件一并限制到 U。","dependencies":["HC02-D01"]},
    {"id":"HC02-P04","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.entryInf"},{"file":"OperatorBounds.lean","name":"HCH02.entryInf_shrink"}],"representation":"entryInf 是合法矩阵族在入口 (i,j) 的像集下确界。用限制后的集合包含证明下确界不增。","dependencies":["HC02-D01","HC02-P03"]},
    {"id":"HC02-P05","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.lip_comp"}],"representation":"U 在复合定义域内，第二个证书的输入是第一个算子在 U 上的实际像。对该像上的上界代入第一步上界，取得 L₂L₁。","dependencies":["HC02-D01","HC02-D03","HC02-D05"]},
    {"id":"HC02-P06","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.coLip_eq_zero"}],"representation":"在全定义域内取所给点对。单项下界迫使 K i j·d_i=0，正输入距迫使 K i j=0。","dependencies":["HC02-D02"]},
    {"id":"HC02-P07","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.coLip_comp"}],"representation":"在同一实际像域代入两步下界，所得 K₂K₁ 合法，起始域的非空性由第一步证书提供。","dependencies":["HC02-D02","HC02-D03","HC02-D05"]},
    {"id":"HC02-P08","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.perturb_forward"}],"representation":"对公共定义域内 U 的任意点对及输出 j，用分量的对称性和两次三角不等式得到从 φ₁ 到 φ₂ 的双 δ 上界。","dependencies":[]},
    {"id":"HC02-P09","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.perturb_reverse"}],"representation":"交换两算子，利用对称性转向扰动前提，再应用正向界。","dependencies":["HC02-P08"]},
    {"id":"HC02-P10","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.perturb_lip"},{"file":"OperatorBounds.lean","name":"HCH02.perturb_lip_swap"}],"representation":"将所选算子的局部 Lip 上界代入相应方向的扰动界，加项为 2δ_j，两个方向均有声明。","dependencies":["HC02-D01","HC02-D03","HC02-P08","HC02-P09"]},
    {"id":"HC02-P11","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.perturb_coLip"},{"file":"OperatorBounds.lean","name":"HCH02.perturb_coLip_swap"}],"representation":"将所选算子的局部 co-Lip 下界与相应方向的扰动界传递相接，两个方向均有声明。","dependencies":["HC02-D02","HC02-D03","HC02-P08","HC02-P09"]},
    {"id":"HC02-P12","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.lip_chain"}],"representation":"在实际输入域逐步具有 Lip 证书时，对施行顺序列表归纳，所得指定乘积在初始域上约束全复合。定理也覆盖空列表。","dependencies":["HC02-D01","HC02-D04","HC02-D05","HC02-P05","HC02-P14"]},
    {"id":"HC02-P13","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.coLip_chain"}],"representation":"列表非空，且每步在实际输入域上具有 co-Lip 证书。首证书给出初始域非空性，对像域归纳得到指定乘积。","dependencies":["HC02-D02","HC02-D04","HC02-D05","HC02-P07","HC02-P15"]},
    {"id":"HC02-P14","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.lip_unit"}],"representation":"恒等算子用单位矩阵逐分量保持距离，适用于 dom id 的任一子集，因而包括正文的非空情形。","dependencies":["HC02-D01","HC02-D04","HC02-D05"]},
    {"id":"HC02-P15","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.coLip_unit"}],"representation":"对非空 U⊆dom id，单位矩阵逐分量保持距离并满足 co-Lip 的非空条件。","dependencies":["HC02-D02","HC02-D04","HC02-D05"]},
    {"id":"HC02-P16","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.product_expansion"},{"file":"OperatorBounds.lean","name":"HCH02.product_zero_iff"},{"file":"OperatorBounds.lean","name":"HCH02.lip_chain_zero_iff"}],"representation":"非空实际证书链有对应的路径和展开。乘积条目为零等价于每个完整中间序列有零边。单步核对见 single_path 与 product_single。","dependencies":["HC02-D01","HC02-D03","HC02-D04","HC02-D05","HC02-D06"]},
    {"id":"HC02-P17","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.product_pos_iff"},{"file":"OperatorBounds.lean","name":"HCH02.coLip_chain_pos_iff"}],"representation":"对非空实际 co-Lip 证书链，乘积条目严格正当且仅当至少一个完整中间序列所有边严格正。单步核对见 single_path。","dependencies":["HC02-D02","HC02-D04","HC02-D05","HC02-D06","HC02-P16"]},
    {"id":"HC02-P18","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.scalar_zero_input"}],"representation":"U 内点对输入距为零且输出距正时，对所有 ENNReal 标量乘以零均为零，故可行集为空、下确界为 ⊤。","dependencies":["HC02-D08"]},
    {"id":"HC02-P19","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.scalar_attained"}],"representation":"正且有限的下确界可行。对每个点对分别处理零、有限正和无限输入距离，有限正情形以除法与稠密性反证。","dependencies":["HC02-D08","HC02-P21"]},
    {"id":"HC02-P20","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.scalar_up"}],"representation":"乘以固定 ENNReal 输入距离单调，因此从任意可行 λ₀ 可推出任意 λ₁≥λ₀ 可行。","dependencies":["HC02-D08"]},
    {"id":"HC02-P21","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.scalar_above"}],"representation":"严格大于下确界的 λ 下方存在一个可行常数，再由向上封闭得到 λ 可行。包含正文正有限下确界及 λ=⊤ 的情形。","dependencies":["HC02-D08","HC02-P20"]},
    {"id":"HC02-P22","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.scalar_inf_zero"}],"representation":"下确界为零时，每个严格正常数都可行，涵盖正文的有限严格正常数。","dependencies":["HC02-D08","HC02-P21"]},
    {"id":"HC02-P23","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.gapDist"},{"file":"OperatorBounds.lean","name":"HCH02.gapGauge"},{"file":"OperatorBounds.lean","name":"HCH02.gap_example"}],"representation":"点空间是 Option Bool，吸收元为 none，指标是 Bool。两个非吸收点的输入距为 ⊤，输出距为 1。取恒等算子及其非空定义域，证明下确界为零且零不可行，并验证两分量全部规范公理。","dependencies":["HC02-D05","HC02-D08"]},
    {"id":"HC02-P24","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.channelLip_finite_iff"}],"representation":"下确界有限时，在它和 ⊤ 之间选可行常数；反向由下确界小于等于任何可行常数得出。","dependencies":["HC02-D08","HC02-P21"]},
    {"id":"HC02-P25","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.term_remove"}],"representation":"零系数与任意 ENNReal 输入距的乘积为零，输出和等于删除该输入指标后的和。","dependencies":["HC02-D03"]},
    {"id":"HC02-P26","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.row_bound"}],"representation":"在合法 Lip 证书的第 j 行，若只有输入 i 可能非零，则对 U 的所有点对保留且仅保留该项。","dependencies":["HC02-D01","HC02-D03","HC02-D07"]},
    {"id":"HC02-P27","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.col_bound"}],"representation":"固定输入 i，若仅指定输出 j 可能非零，则对所有 U 内点对和 k≠j，该输入在第 k 行的求和项为零。","dependencies":["HC02-D01","HC02-D07"]},
    {"id":"HC02-P28","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.diagonal_upper"}],"representation":"对每个分量 j，把对角条件化成该行只保留输入 j，应用单行上界。","dependencies":["HC02-D01","HC02-D07","HC02-P26"]},
    {"id":"HC02-P29","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.row_two_sided"}],"representation":"任意 U 内点对的下界用 co-Lip 对角单项，上界用同一分量的 Lip 稀疏行。K 可有任意非对角项。","dependencies":["HC02-D01","HC02-D02","HC02-D07","HC02-P26"]},
    {"id":"HC02-P30","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.diagonal_two_sided"},{"file":"OperatorBounds.lean","name":"HCH02.diagonal_two_sided_finite"}],"representation":"对每个 j 同时给出双侧标量界；有限分支额外保留 L_jj 与 K_jj 严格小于 ⊤。","dependencies":["HC02-D01","HC02-D02","HC02-D07","HC02-P29"]},
    {"id":"HC02-P31","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.coLip_pos"}],"representation":"正系数与正输入距的乘积严格正，利用合法 co-Lip 证书的单项下界推出正输出距。","dependencies":["HC02-D02"]},
    {"id":"HC02-P32","status":"complete","declarations":[{"file":"OperatorBounds.lean","name":"HCH02.coLip_reflects_zero"}],"representation":"对每个对角通道，正输入距会给出正输出距，与输出族零距矛盾，从而输入也族零距。","dependencies":["HC02-D02","HC02-P31"]}
  ]
}
