{
  "schema": "math-gauge.goal-attainment-policy/v1",
  "version": "0.2.0",
  "benchmark_version": "0.6.0",
  "condition": "nonlogical_retry_3",
  "status": "post-observation-ai-review-human-pending",
  "content_reliability": "correct-and-supported-actual-substantive-assertion-weight-over-actual-assertion-weight",
  "goal_attainment": "accepted-complete-independent-mathematical-result-weight-over-all-required-result-weight",
  "acceptance": ["mathematically-correct", "necessary-proof-closed", "original-scope-aligned", "actually-delivered-and-independently-usable"],
  "granularity": "source-result-or-complete-object-not-proof-step-check-or-obligation",
  "goal_weights": "original-independent-result-weights-normalized-within-task; acceptance-facets-have-no-separate-positive-weight",
  "aggregation": "unchanged-task-variant-family-category-hierarchy-and-fixed-100-frame",
  "existential_goals": "one-explicitly-delivered-complete-valid-scheme-suffices-only-when-original-task-allows-one",
  "dependencies": "only-actual-necessary-dependencies-propagate-failure; no-reviewer-repaired-or-cross-round-union",
  "detachable_false_extras": "reduce-content-reliability-without-invalidating-an-independent-complete-result",
  "selfcheck": {
    "rounds": 3,
    "aggregation": "fixed-three-round-average-within-one-family",
    "goals_per_round": {"complete_accurate_diagnosis": 30, "all_necessary_repairs_and_verified_delivery": 70},
    "old_correct_work_or_no_regression_alone_is_attainment": false,
    "verified_keep": "allowed-only-if-parent-already-complete-and-audited-correctly",
    "no_regression_and_no_false_complete": "necessary-acceptance-conditions"
  },
  "theorem_extension": {"complete_research_result_goals_per_case": 1, "baseline_is_necessary_gate_not_new_research_credit": true, "cumulative_R_levels_are_independent_goals": false},
  "unknowns": "fixed-required-denominator-and-interval; never-charge-unrun-as-mathematical-failure",
  "strict_difference": "SMC-accepts-the-whole-task-or-prescribed-trajectory; single-goal-cases-may-coincide",
  "legacy_coverage": {"version": "0.1.0", "policy": "content-rate-policy.json", "public_archive": "content-rate-coverage-v0.1.0.json", "silently_relabel_as_attainment": false},
  "new_candidate_calls": 0,
  "changes_MC_RMC_SMC": false,
  "private_projection": "anonymous-category-aggregates-and-opaque-hashes-only"
}
