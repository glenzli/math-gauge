{
  "schema": "math-gauge.isolated-cli/v1",
  "client": "agy",
  "cli_identity": "<absolute-inspection-directory>/identity.json",
  "prompt": "<absolute-task-file>",
  "run_dir": "<absolute-new-run-directory>",
  "model": "<explicit-model-id>",
  "effort": "<explicit-supported-effort>",
  "deny_read_roots": ["<absolute-home-or-data-root>", "<absolute-temporary-data-root>"],
  "read_exceptions": [
    {"path": "<absolute-cli-installation-directory>", "kind": "subpath", "purpose": "CLI installation only"}
  ],
  "credential_links": [
    {"source": "<absolute-existing-oauth-file>", "target": "antigravity-cli/antigravity-oauth-token"}
  ],
  "probes": [
    {"category": "reference", "path": "<absolute-existing-reference-file>"},
    {"category": "history", "path": "<absolute-existing-history-file>"},
    {"category": "prior_run", "path": "<absolute-existing-prior-response-file>"}
  ]
}
