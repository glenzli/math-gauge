{
  "id": "MG-GF108",
  "version": "0.1.1",
  "parent_case_id": "MG-F108",
  "title": "加权逆算子的正性边界与接口修复",
  "track": "determinate",
  "task_kind": "repair",
  "stages": [
    {
      "id": "S1",
      "title": "正且有下界的权重",
      "kind": "prove",
      "depends_on": [],
      "assumptions": [
        "v_n≥1 对所有 n",
        "f,u 为任意实序列",
        "r∈ℕ、C∈ℝ"
      ],
      "expected": "true",
      "required_evidence": [
        "证明 T_v、S_v 互逆及 S_v 线性",
        "证明精确加权恒等式和一阶同常数控制",
        "证明 Rapid_v(f)→Rapid_v(S_v f)"
      ],
      "critical_errors": [
        "不保留给定 C",
        "仅证明某个固定 r 或有限支撑情形"
      ],
      "points": 15,
      "lean_required": false
    },
    {
      "id": "S2",
      "title": "原权重的完整目标",
      "kind": "prove",
      "depends_on": [
        "S1"
      ],
      "assumptions": [
        "w_n=n+1",
        "无需 Rapid、有限支撑等条件来定义逆和证明唯一性"
      ],
      "expected": "true",
      "required_evidence": [
        "特化 S1 到 w",
        "证明 T_w u=f 的唯一解为 S_w f",
        "保持一阶而非二阶输入并输出全部原目标"
      ],
      "critical_errors": [
        "仍要求 InputControl 原二阶接口",
        "把唯一性只限于 Rapid 解"
      ],
      "points": 20,
      "lean_required": false
    },
    {
      "id": "S3",
      "title": "取消统一正下界",
      "kind": "decide",
      "depends_on": [
        "S1",
        "S2"
      ],
      "assumptions": [
        "仅要求 v_n>0 对所有 n",
        "不要求存在统一 ε>0 使 v_n≥ε",
        "仍只要求 S_v 保持 Rapid_v 及一阶同常数估计"
      ],
      "expected": "true",
      "required_evidence": [
        "判断 S1 的互逆、线性、一阶估计及 S_v 的 Rapid 保持是否仍成立",
        "指出每个证明实际所用的正性范围",
        "不额外声称 T_v 必保持 Rapid_v"
      ],
      "critical_errors": [
        "误用控制阶数单调性来要求 v≥1",
        "在无下界时增加未要求且可能假的 T_v 保持结论"
      ],
      "points": 15,
      "lean_required": false
    },
    {
      "id": "S4",
      "title": "允许零权重的逆问题",
      "kind": "decide",
      "depends_on": [
        "S1",
        "S3"
      ],
      "assumptions": [
        "仅要求 v_n≥0",
        "允许至少一个 n0 满足 v_n0=0",
        "仍要求 S_v 为 T_v 在全部 Seq 上的双侧逆"
      ],
      "expected": "false",
      "required_evidence": [
        "判断双侧逆是否仍成立",
        "给出零位置和具体序列否定至少一个逆等式",
        "解释存在性、唯一性失效的不同表现"
      ],
      "critical_errors": [
        "把乘法恒等式成立误当成除法可逆",
        "忽略 Lean 中除以零的值"
      ],
      "points": 15,
      "lean_required": false
    },
    {
      "id": "S5",
      "title": "常数为零的原估计端点",
      "kind": "decide",
      "depends_on": [
        "S2",
        "S4"
      ],
      "assumptions": [
        "回到严格正的原权重 w_n=n+1",
        "r∈ℕ",
        "Control_w(r,0,f)"
      ],
      "expected": "true",
      "required_evidence": [
        "证明 f=0",
        "证明 Control_w(r,0,S_w f)，无需增加阶数",
        "解释端点不推出一般 C 的零损失估计"
      ],
      "critical_errors": [
        "把 v 有零点的 S4 结论继承到原 w",
        "从 C=0 的特殊情况推广任意正 C"
      ],
      "points": 10,
      "lean_required": false
    },
    {
      "id": "S6",
      "title": "修复原接口并实现扩展",
      "kind": "formalize",
      "depends_on": [
        "S1",
        "S2",
        "S3",
        "S4",
        "S5"
      ],
      "assumptions": [
        "保持原 Core 的数学定义",
        "修复后的原主定理只接受一阶 Control 输入",
        "扩展权重的假设须逐定理局部写出"
      ],
      "expected": "construction",
      "required_evidence": [
        "提交 Core.lean、Multiplier.lean、Candidate.lean、Extensions.lean",
        "原候选完整恢复一阶同 C 估计及其它原目标",
        "Extensions 完整实现 S1、S3、S4、S5 的结论及反例",
        "实际共同编译与公理审计"
      ],
      "critical_errors": [
        "将 InputControl 只改名而仍含 r+2",
        "在全文件默认 v≥1 导致 S3 名不副实",
        "靠假设可逆来规避零点反例"
      ],
      "points": 25,
      "lean_required": true
    }
  ],
  "turns": [
    {
      "stage_id": "S3",
      "earlier_stage_ids": [
        "S1",
        "S2"
      ],
      "changed_assumptions": "将 v≥1 改为逐点 v>0，删除统一正下界",
      "expected_truth": "true",
      "tempting_invalid_transfer": "把 control_down 所需条件误转移成精确乘法恒等式所需条件",
      "correct_boundary": "目标的 S_v 估计只用逐点正性，不用阶数下降",
      "mechanism": "sufficient versus actually used hypothesis",
      "target_claim": "只要求逐点 v_n>0 时，互逆、S_v 线性、一阶同常数控制及 S_v 保持 Rapid_v 均仍成立。",
      "scope": "stage"
    },
    {
      "stage_id": "S4",
      "earlier_stage_ids": [
        "S1",
        "S3"
      ],
      "changed_assumptions": "把逐点正改成非负且允许零点，仍要求全部序列上的双侧逆",
      "expected_truth": "false",
      "tempting_invalid_transfer": "将乘法估计延伸成可逆性而不检查分母非零",
      "correct_boundary": "零点使 T_v 丢失该坐标且限制像",
      "mechanism": "operator kernel and domain boundary",
      "target_claim": "允许非负权重有零点时，S_v 仍是 T_v 在全部实序列上的双侧逆。",
      "scope": "stage"
    },
    {
      "stage_id": "S5",
      "earlier_stage_ids": [
        "S2",
        "S4"
      ],
      "changed_assumptions": "回到原正权重并把控制常数固定为零",
      "expected_truth": "true",
      "tempting_invalid_transfer": "从一般零损失失败或零权重失败推断端点也失败",
      "correct_boundary": "严格正权重与零上界强制输入为零",
      "mechanism": "zero endpoint and restored assumptions",
      "target_claim": "原严格正权重下 Control_w(r,0,f) 蕴含 Control_w(r,0,S_w f)。",
      "scope": "stage"
    }
  ],
