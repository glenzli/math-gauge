import MathGauge.GP003.LocalizationNeighborhoods

/-! Intersections of point neighborhoods are cofinal in neighborhoods of the
actual intersection of two local-spectrum images. The algebraic refinement is
proved using the prime ideal theorem, without assuming the two images are open. -/
namespace MathGauge.GP003
noncomputable section
set_option backward.isDefEq.respectTransparency false
open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite TopCat.Presheaf
open MathGauge.PublicProof.Semilocal

universe u
variable {R : Type u} [CommRing R]

/-- Denominators generated by the two prime complements, explicitly as products. -/
def pairDenominators (p q : PrimeSpectrum R) : Submonoid R where
  carrier := {r | ∃ a b, a ∉ p.asIdeal ∧ b ∉ q.asIdeal ∧ a * b = r}
  one_mem' := ⟨1,1,p.isPrime.one_notMem,q.isPrime.one_notMem,mul_one 1⟩
  mul_mem' := by
    rintro r s ⟨a,b,ha,hb,rfl⟩ ⟨c,d,hc,hd,rfl⟩
    exact ⟨a*c,b*d,fun h => (p.isPrime.mem_or_mem h).elim ha hc,
      fun h => (q.isPrime.mem_or_mem h).elim hb hd, by ring⟩

/-- Any open containing all common generalizations contains the intersection
of some neighborhood of p and some neighborhood of q. -/
theorem exists_pair_neighborhood_refinement (p q : PrimeSpectrum R)
    (W : Opens (PrimeSpectrum R))
    (hW : {r : PrimeSpectrum R | r.asIdeal ≤ p.asIdeal ∧ r.asIdeal ≤ q.asIdeal} ⊆ W) :
    ∃ (U : OpenNhds (X := TopCat.of (PrimeSpectrum R)) p)
      (V : OpenNhds (X := TopCat.of (PrimeSpectrum R)) q), U.1 ⊓ V.1 ≤ W := by
  classical
  obtain ⟨I,hI⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal _).mp W.isOpen.isClosed_compl
  have hnd : ¬ Disjoint (I : Set R) (pairDenominators p q : Set R) := by
    intro hd
    obtain ⟨J,hJ,hIJ,hdJ⟩ := I.exists_le_prime_disjoint (pairDenominators p q) hd
    have hJp : J ≤ p.asIdeal := by
      intro a ha
      by_contra hn
      exact Set.disjoint_left.mp hdJ ha ⟨a,1,hn,q.isPrime.one_notMem,mul_one a⟩
    have hJq : J ≤ q.asIdeal := by
      intro b hb
      by_contra hn
      exact Set.disjoint_left.mp hdJ hb ⟨1,b,p.isPrime.one_notMem,hn,one_mul b⟩
    have hin : (⟨J,hJ⟩ : PrimeSpectrum R) ∈ W := hW ⟨hJp,hJq⟩
    have hout : (⟨J,hJ⟩ : PrimeSpectrum R) ∈ (W : Set (PrimeSpectrum R))ᶜ := by
      rw [hI]
      exact hIJ
    exact hout hin
  obtain ⟨r,hrI,hr⟩ := Set.not_disjoint_iff.mp hnd
  obtain ⟨a,b,ha,hb,rfl⟩ := hr
  refine ⟨⟨PrimeSpectrum.basicOpen a,ha⟩,⟨PrimeSpectrum.basicOpen b,hb⟩,?_⟩
  intro z hz
  by_contra hn
  have hzI : I ≤ z.asIdeal := by
    have hh : z ∈ (W : Set (PrimeSpectrum R))ᶜ := hn
    rw [hI] at hh
    exact hh
  exact (z.isPrime.mem_or_mem (hzI hrI)).elim hz.1 hz.2

/-- The actual intersection of the two localization spectrum images. -/
def pairLocalImage (p q : PrimeSpectrum R) : Set (PrimeSpectrum R) :=
  Set.range (PrimeSpectrum.comap (algebraMap R (Localization.AtPrime p.asIdeal))) ∩
    Set.range (PrimeSpectrum.comap (algebraMap R (Localization.AtPrime q.asIdeal)))

@[simp] theorem pairLocalImage_eq (p q : PrimeSpectrum R) :
    pairLocalImage p q = {r | r.asIdeal ≤ p.asIdeal ∧ r.asIdeal ≤ q.asIdeal} := by
  simp only [pairLocalImage, prime_localization_image]
  rfl

def pairNeighborhoodToImage (p q : PrimeSpectrum R) :
    PairNeighborhoods (X := TopCat.of (PrimeSpectrum R)) p q ⥤
      (SetNeighborhoods (X := TopCat.of (PrimeSpectrum R)) (pairLocalImage p q))ᵒᵖ where
  obj a := op ⟨a.1.unop.1 ⊓ a.2.unop.1, by
    intro r hr
    rw [pairLocalImage_eq] at hr
    exact ⟨((PrimeSpectrum.le_iff_specializes r p).mp hr.1).mem_open
      a.1.unop.1.isOpen a.1.unop.2,
      ((PrimeSpectrum.le_iff_specializes r q).mp hr.2).mem_open
        a.2.unop.1.isOpen a.2.unop.2⟩⟩
  map {a b} f := (homOfLE (show b.1.unop.1 ⊓ b.2.unop.1 ≤ a.1.unop.1 ⊓ a.2.unop.1 from
    inf_le_inf f.1.unop.le f.2.unop.le)).op
  map_id _ := Subsingleton.elim _ _
  map_comp _ _ := Subsingleton.elim _ _

/-- Genuine cofinality, including the refinement and connectedness requirements. -/
theorem pairNeighborhoodToImage_final (p q : PrimeSpectrum R) :
    (pairNeighborhoodToImage p q).Final := by
  apply Functor.final_of_exists_of_isFiltered
  · intro W
    obtain ⟨U,V,hUV⟩ := exists_pair_neighborhood_refinement p q W.unop.1 (by
      simpa only [← pairLocalImage_eq] using W.unop.2)
    exact ⟨(op U,op V),⟨(homOfLE hUV).op⟩⟩
  · intro W a f g
    exact ⟨a,𝟙 _,Subsingleton.elim _ _⟩

theorem pairNeighborhoodToImage_comp (p q : PrimeSpectrum R) :
    pairNeighborhoodToImage p q ⋙ (neighborhood_inclusion (X := TopCat.of (PrimeSpectrum R)) (pairLocalImage p q)).op =
      pairIntersection (X := TopCat.of (PrimeSpectrum R)) p q := by
  rfl


/-- The canonical actual overlap colimit is the value on the full pair image. -/
def overlapLocalizationIso (p q : PrimeSpectrum R)
    (F : (TopCat.of (PrimeSpectrum R)).Presheaf AddCommGrpCat.{u}) :
    overlapValue F p q ≅ neighborhood_value F (pairLocalImage p q) := by
  haveI := pairNeighborhoodToImage_final p q
  exact asIso (colimit.pre
    ((neighborhood_inclusion (X := TopCat.of (PrimeSpectrum R)) (pairLocalImage p q)).op ⋙ F)
    (pairNeighborhoodToImage p q))

@[simp] theorem overlapLocalizationIso_representative (p q : PrimeSpectrum R)
    (F : (TopCat.of (PrimeSpectrum R)).Presheaf AddCommGrpCat.{u})
    (a : PairNeighborhoods (X := TopCat.of (PrimeSpectrum R)) p q) :
    colimit.ι (pairIntersection (X := TopCat.of (PrimeSpectrum R)) p q ⋙ F) a ≫
      (overlapLocalizationIso p q F).hom =
      colimit.ι ((neighborhood_inclusion (X := TopCat.of (PrimeSpectrum R))
        (pairLocalImage p q)).op ⋙ F) ((pairNeighborhoodToImage p q).obj a) :=
  colimit.ι_pre ((neighborhood_inclusion (X := TopCat.of (PrimeSpectrum R))
    (pairLocalImage p q)).op ⋙ F) (pairNeighborhoodToImage p q) a

end
end MathGauge.GP003
