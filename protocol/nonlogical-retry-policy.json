{
  "schema": "math-gauge.nonlogical-retry-policy/v1",
  "version": "0.1.0",
  "benchmark_version": "0.6.0",
  "status": "post-observation-local-draft; human-pending",
  "score_conditions": ["single_attempt", "nonlogical_retry_3"],
  "maximum_total_attempts_per_slot": 3,
  "attempt_count_basis": "effective_model_attempts_excluding_evidenced_pure_system_failures",
  "system_failure_accounting_amended": "2026-11-06; explicit user instruction; post-observation",
  "excluded_system_failures_require": ["specific_native_operational_evidence", "no_scorable_final_delivery", "no_selection_by_mathematical_quality"],
  "pre_model_authentication_transport_failures_count": false,
  "max_output_tokens_counts_as_model_attempt": true,
  "unclassified_failures_count_conservatively": true,
  "preserve_physical_request_numbers_and_system_failure_evidence": true,
  "selection": "first_completed_delivery",
  "eligible_failure_reasons": ["max_output_tokens", "service_error", "execution_interrupted"],
  "requires_no_scorable_final_delivery": true,
  "retry_on_mathematical_error": false,
  "context": "fresh_independent_no_previous_answers_or_evaluator_feedback",
  "conditions": "same_task_model_harness_prompts_tools_sampling_and_per_attempt_budget",
  "exhausted_without_delivery": "zero_delivery_credit_strict_fail_theorem_truth_unknown",
  "fixed_denominators": true,
  "preserve_original_attempts_and_scores": true,
  "allow_operator_declared_provisional_analysis": true,
  "formal_comparison_eligible": false,
  "human_review": "pending",
  "new_candidate_calls_by_import": 0
}
